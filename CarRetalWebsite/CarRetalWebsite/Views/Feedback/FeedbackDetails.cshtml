@model CarRetalWebsite.Models.Feedback
@{
    ViewData["Title"] = "Chi tiết đánh giá đơn hàng #" + Model.BookingId;
    var carImage = Model.Booking.Car.CarImages?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl 
                   ?? Model.Booking.Car.CarImages?.FirstOrDefault()?.ImageUrl 
                   ?? "https://images.unsplash.com/photo-1549399542-7e3f8b79c341?auto=format&fit=crop&w=600&q=80";
}

<style>
    .detail-card {
        background: #ffffff;
        border-radius: 24px;
        box-shadow: var(--shadow-lg);
        border: 1px solid rgba(226, 232, 240, 0.8);
        overflow: hidden;
    }

    .detail-header {
        background-color: #0f172a;
        color: #ffffff;
        padding: 25px 30px;
    }

    .detail-body {
        padding: 35px;
    }

    .car-card-flat {
        background-color: var(--bg-light);
        border-radius: 16px;
        padding: 20px;
        border: 1px solid rgba(226, 232, 240, 0.5);
    }

    .flat-car-img {
        width: 150px;
        height: 100px;
        object-fit: cover;
        border-radius: 10px;
        background-color: #ffffff;
    }

    .review-stars {
        color: #f59e0b;
        font-size: 1.5rem;
    }

    .comment-text-box {
        background-color: #f8fafc;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #e2e8f0;
        font-size: 1.05rem;
        line-height: 1.6;
    }

    .owner-response-card {
        border: 1px solid var(--primary-light);
        background-color: #f0f9ff;
        border-radius: 16px;
        padding: 25px;
        margin-top: 30px;
        position: relative;
    }

    .owner-response-card::before {
        content: '\f3e5';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        position: absolute;
        top: -15px;
        left: 30px;
        background-color: var(--primary-color);
        color: #ffffff;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        box-shadow: var(--shadow-sm);
    }
</style>

<div class="container my-5">
    <!-- Breadcrumbs -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Feedback/MyFeedbacks" class="text-decoration-none">Đánh giá của tôi</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết đánh giá đơn #@Model.BookingId</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="detail-card">
                <div class="detail-header d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="h4 fw-bold m-0 text-white">Đánh giá & Phản hồi dịch vụ</h2>
                        <span class="small text-white-50">Mã đơn đặt xe: #@Model.BookingId</span>
                    </div>
                    <span class="badge bg-light text-dark py-2 px-3 fw-bold rounded-3">@Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                </div>

                <div class="detail-body">
                    <!-- Car Flat Card Info -->
                    <div class="car-card-flat mb-4 d-flex align-items-center gap-4 flex-wrap">
                        <img src="@carImage" alt="@Model.Booking.Car.CarName" class="flat-car-img" />
                        <div>
                            <h3 class="h5 fw-bold text-dark mb-1">@Model.Booking.Car.CarName</h3>
                            <p class="small text-muted mb-2">Hãng xe: <strong>@Model.Booking.Car.Brand</strong> | Biển số: <strong>@Model.Booking.Car.LicensePlate</strong></p>
                            <p class="small text-muted mb-0">Thời gian thuê: @Model.Booking.StartDate.ToString("dd/MM/yyyy") - @Model.Booking.EndDate.ToString("dd/MM/yyyy") (@Model.Booking.TotalDays ngày)</p>
                        </div>
                    </div>

                    <!-- Rating Stars -->
                    <div class="mb-4 text-center">
                        <div class="review-stars mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Model.Rating)
                                {
                                    <i class="fa-solid fa-star"></i>
                                }
                                else
                                {
                                    <i class="fa-regular fa-star"></i>
                                }
                            }
                        </div>
                        <span class="fw-bold text-dark fs-5">@Model.Rating / 5 điểm hài lòng</span>
                    </div>

                    <!-- Customer Comment -->
                    <div class="mb-4">
                        <h4 class="h6 fw-bold text-muted text-uppercase mb-2">Nội dung đánh giá của bạn</h4>
                        <div class="comment-text-box">
                            <p class="m-0 text-dark" style="white-space: pre-wrap;">@Model.Comment</p>
                        </div>
                        <div class="text-end text-muted small mt-2">
                            <span>Viết lúc: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                            @if (Model.UpdatedAt != Model.CreatedAt)
                            {
                                <span class="ms-2 font-italic">(Đã cập nhật lúc: @Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm"))</span>
                            }
                        </div>
                    </div>

                    <!-- Owner Response -->
                    @if (!string.IsNullOrEmpty(Model.OwnerReply))
                    {
                        <div class="owner-response-card">
                            <h4 class="h6 fw-bold text-primary mb-2 ps-3 text-uppercase">Chủ xe phản hồi</h4>
                            <p class="text-dark m-0 ps-3" style="line-height: 1.6;">@Model.OwnerReply</p>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 rounded-4 bg-light border border-dashed text-muted mt-4">
                            <i class="fa-solid fa-hourglass-half me-2 text-warning"></i>
                            Chưa có phản hồi từ chủ xe cho đánh giá này.
                        </div>
                    }

                    <!-- Back / Edit Buttons -->
                    <div class="mt-4 pt-3 border-top d-flex gap-2 justify-content-end">
                        <form method="POST" action="/Feedback/DeleteFeedback" onsubmit="return confirm('Bạn có chắc muốn xóa đánh giá này không?');" class="me-auto">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.FeedbackId" />
                            <button type="submit" class="btn btn-outline-danger py-2 px-3 rounded-3 fw-bold">
                                <i class="fa-solid fa-trash-can me-2"></i>Xóa đánh giá
                            </button>
                        </form>
                        <a href="/Feedback/MyFeedbacks" class="btn btn-light py-2 px-4 rounded-3 fw-bold text-muted">Quay lại</a>
                        <a href="/Feedback/EditFeedback?id=@Model.FeedbackId" class="btn-primary-custom border-0 py-2 px-4">
                            <i class="fa-solid fa-pen-to-square me-2"></i>Chỉnh sửa
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
