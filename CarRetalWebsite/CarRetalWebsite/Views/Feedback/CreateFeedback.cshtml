@{
    ViewData["Title"] = "Viết đánh giá dịch vụ";
    var booking = ViewBag.Booking as CarRetalWebsite.Models.Booking;
    var carImage = booking?.Car?.CarImages?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl 
                   ?? booking?.Car?.CarImages?.FirstOrDefault()?.ImageUrl 
                   ?? "https://images.unsplash.com/photo-1549399542-7e3f8b79c341?auto=format&fit=crop&w=600&q=80";
}

<style>
    .feedback-form-card {
        background: #ffffff;
        border-radius: 24px;
        box-shadow: var(--shadow-lg);
        border: 1px solid rgba(226, 232, 240, 0.8);
        overflow: hidden;
    }

    .form-header {
        background-color: #0f172a;
        color: #ffffff;
        padding: 25px 30px;
    }

    .form-body {
        padding: 35px;
    }

    .booking-flat-info {
        background-color: var(--bg-light);
        border-radius: 16px;
        padding: 20px;
        border: 1px solid rgba(226, 232, 240, 0.5);
    }

    .flat-car-img {
        width: 140px;
        height: 90px;
        object-fit: cover;
        border-radius: 10px;
    }

    /* Star selection style */
    .star-select-container {
        display: flex;
        flex-direction: row-reverse;
        justify-content: center;
        gap: 12px;
        margin: 20px 0;
    }

    .star-select-container input {
        display: none;
    }

    .star-select-container label {
        font-size: 2.2rem;
        color: #cbd5e1; /* Gray star default */
        cursor: pointer;
        transition: color 0.2s ease, transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .star-select-container label:hover,
    .star-select-container label:hover ~ label,
    .star-select-container input:checked ~ label {
        color: #f59e0b; /* Amber yellow color */
    }

    .star-select-container label:active {
        transform: scale(1.3);
    }
</style>

<div class="container my-5">
    <!-- Breadcrumbs -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Booking/MyBookings" class="text-decoration-none">Lịch sử đặt xe</a></li>
            <li class="breadcrumb-item active" aria-current="page">Viết đánh giá</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="feedback-form-card">
                <div class="form-header">
                    <h2 class="h4 fw-bold m-0 text-white"><i class="fa-solid fa-pen-nib me-2"></i>Đánh giá chuyến đi</h2>
                    <p class="small text-white-50 mb-0">Hãy chia sẻ trải nghiệm thuê xe của bạn</p>
                </div>

                <div class="form-body">
                    <!-- Booking Brief Info -->
                    @if (booking != null)
                    {
                        <div class="booking-flat-info mb-4 d-flex align-items-center gap-4 flex-wrap">
                            <img src="@carImage" alt="@booking.Car.CarName" class="flat-car-img" />
                            <div>
                                <h3 class="h5 fw-bold text-dark mb-1">@booking.Car.CarName</h3>
                                <p class="small text-muted mb-2">Hãng xe: <strong>@booking.Car.Brand</strong> | Biển số: <strong>@booking.Car.LicensePlate</strong></p>
                                <p class="small text-muted mb-0">Thuê từ: @booking.StartDate.ToString("dd/MM/yyyy") đến @booking.EndDate.ToString("dd/MM/yyyy") (@booking.TotalDays ngày)</p>
                            </div>
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger rounded-4 shadow-sm mb-4">
                            <ul class="m-0 ps-3">
                                @foreach (var modelState in ViewData.ModelState.Values)
                                {
                                    foreach (var error in modelState.Errors)
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                }
                            </ul>
                        </div>
                    }

                    <form method="POST" action="/Feedback/ConfirmCreateFeedback">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookingId" value="@(booking?.BookingId ?? 0)" />

                        <!-- Interactive Star Selector -->
                        <div class="mb-4 text-center">
                            <label class="form-label fw-bold text-dark d-block">Mức độ hài lòng của bạn</label>
                            
                            <div class="star-select-container">
                                <input type="radio" id="star5" name="rating" value="5" required />
                                <label for="star5" title="5 sao - Rất hài lòng"><i class="fa-solid fa-star"></i></label>
                                
                                <input type="radio" id="star4" name="rating" value="4" />
                                <label for="star4" title="4 sao - Hài lòng"><i class="fa-solid fa-star"></i></label>
                                
                                <input type="radio" id="star3" name="rating" value="3" />
                                <label for="star3" title="3 sao - Bình thường"><i class="fa-solid fa-star"></i></label>
                                
                                <input type="radio" id="star2" name="rating" value="2" />
                                <label for="star2" title="2 sao - Không hài lòng"><i class="fa-solid fa-star"></i></label>
                                
                                <input type="radio" id="star1" name="rating" value="1" />
                                <label for="star1" title="1 sao - Rất tệ"><i class="fa-solid fa-star"></i></label>
                            </div>
                            <span class="small text-muted" id="rating-desc">Vui lòng chọn số sao để đánh giá</span>
                        </div>

                        <!-- Comment Text Area -->
                        <div class="mb-4">
                            <label for="Comment" class="form-label fw-bold text-dark">Nội dung ý kiến đóng góp</label>
                            <textarea id="Comment" name="comment" class="form-control rounded-3" rows="5" 
                                      placeholder="Hãy nhập ý kiến của bạn về chất lượng xe, độ sạch sẽ, thái độ của chủ xe..." required></textarea>
                        </div>

                        <!-- Submit and Back -->
                        <div class="d-flex justify-content-end gap-2 border-top pt-3">
                            <a href="/Booking/MyBookings" class="btn btn-light py-2 px-4 rounded-3 text-muted fw-bold">Hủy</a>
                            <button type="submit" class="btn-primary-custom border-0 py-2 px-4 fs-6">
                                <i class="fa-regular fa-paper-plane me-2"></i>Gửi đánh giá
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const ratingInputs = document.querySelectorAll('.star-select-container input');
        const ratingDesc = document.getElementById('rating-desc');
        
        const descs = {
            "5": "5 sao - Rất hài lòng tuyệt đối!",
            "4": "4 sao - Dịch vụ tốt, rất hài lòng",
            "3": "3 sao - Bình thường, tạm chấp nhận được",
            "2": "2 sao - Không hài lòng, cần cải thiện nhiều",
            "1": "1 sao - Rất tệ, trải nghiệm không tốt"
        };

        ratingInputs.forEach(input => {
            input.addEventListener('change', function () {
                ratingDesc.textContent = descs[this.value];
                ratingDesc.className = "small fw-bold text-primary";
            });
        });
    });
</script>
