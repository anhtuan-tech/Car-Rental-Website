@model CarRetalWebsite.Models.Car

@{
    ViewData["Title"] = "Car Details";
    var statusClass = (Model.Status ?? "").ToLower().Replace(" ", "-");
}

<style>
    :root {
        --brand: #2563eb;
        --brand-dark: #1d4ed8;
        --ink: #0f172a;
        --muted: #64748b;
        --line: #e6eaf1;
        --bg: #f4f6fb;
        --card: #ffffff;
    }

    body {
        background: radial-gradient(1200px 500px at 100% -10%, rgba(37, 99, 235, 0.08), transparent 60%), var(--bg);
        color: var(--ink);
    }

    .cr-container {
        max-width: 1080px;
        margin: 0 auto;
        padding: 32px 20px 56px;
    }

    /* BREADCRUMB */
    .cr-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        color: var(--muted);
        margin-bottom: 18px;
    }

        .cr-breadcrumb a {
            color: var(--muted);
            text-decoration: none;
        }

            .cr-breadcrumb a:hover {
                color: var(--brand);
            }

    .cr-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        border-radius: 12px;
        padding: 11px 18px;
        border: 1px solid transparent;
        text-decoration: none;
        transition: all 0.18s ease;
        cursor: pointer;
        font-size: 0.9rem;
        line-height: 1;
    }

    .cr-btn-ghost {
        background: var(--card);
        color: var(--ink);
        border-color: var(--line);
    }

        .cr-btn-ghost:hover {
            border-color: var(--brand);
            color: var(--brand);
        }

    .cr-btn-primary {
        background: var(--brand);
        color: #fff;
        box-shadow: 0 8px 18px rgba(37, 99, 235, 0.25);
    }

        .cr-btn-primary:hover {
            background: var(--brand-dark);
            color: #fff;
            transform: translateY(-1px);
        }

    .cr-btn-success {
        background: #16a34a;
        color: #fff;
        box-shadow: 0 8px 18px rgba(22, 163, 74, 0.25);
    }

        .cr-btn-success:hover {
            background: #15803d;
            color: #fff;
            transform: translateY(-1px);
        }

    /* LAYOUT */
    .cr-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 24px;
        align-items: start;
    }

    .cr-card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 18px;
        box-shadow: 0 12px 34px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }

    .cr-card-pad {
        padding: 24px;
    }

    /* HERO / HEADER OF DETAIL */
    .cr-hero {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        padding: 24px;
        border-bottom: 1px solid var(--line);
    }

    .cr-hero-name {
        font-size: 1.6rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin: 0;
    }

    .cr-hero-sub {
        color: var(--muted);
        margin: 6px 0 0;
        font-size: 0.92rem;
    }

    .cr-plate {
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
        font-size: 0.85rem;
        font-weight: 600;
        background: #f1f5f9;
        border: 1px solid var(--line);
        padding: 4px 10px;
        border-radius: 8px;
    }

    .status {
        display: inline-flex;
        align-items: center;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

        .status::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 999px;
            margin-right: 7px;
            background: currentColor;
        }

    .status-available {
        background: #dcfce7;
        color: #16a34a;
    }

    .status-rented {
        background: #fee2e2;
        color: #dc2626;
    }

    .status-maintenance {
        background: #fef3c7;
        color: #d97706;
    }

    .status-inactive {
        background: #e9edf3;
        color: #64748b;
    }

    /* INFO GRID */
    .cr-info {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2px;
        background: var(--line);
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid var(--line);
    }

    .cr-info-item {
        background: var(--card);
        padding: 16px 18px;
    }

    .cr-info-label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--muted);
        margin-bottom: 6px;
    }

    .cr-info-value {
        font-size: 0.98rem;
        font-weight: 600;
        color: var(--ink);
        word-break: break-word;
    }

    .cr-price-value {
        color: var(--brand);
        font-size: 1.15rem;
        font-weight: 800;
    }

    /* SECTION TITLE */
    .cr-section-title {
        font-size: 0.95rem;
        font-weight: 800;
        margin: 0 0 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* FORM */
    .cr-label {
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--muted);
        margin-bottom: 8px;
        display: block;
    }

    .cr-select {
        width: 100%;
        border-radius: 12px;
        padding: 11px 14px;
        border: 1px solid var(--line);
        background: #fbfcfe;
        font-size: 0.92rem;
        color: var(--ink);
        transition: 0.18s ease;
    }

        .cr-select:focus {
            outline: none;
            border-color: var(--brand);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
        }

    .cr-form-actions {
        display: flex;
        gap: 10px;
        margin-top: 18px;
    }

    /* IMAGE GALLERY */
    .cr-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
        gap: 12px;
    }

        .cr-gallery img {
            width: 100%;
            height: 110px;
            object-fit: cover;
            border-radius: 12px;
            border: 1px solid var(--line);
            transition: transform 0.18s ease;
        }

            .cr-gallery img:hover {
                transform: scale(1.03);
            }

    .cr-no-image {
        color: var(--muted);
        font-size: 0.9rem;
        text-align: center;
        padding: 24px;
        border: 1px dashed var(--line);
        border-radius: 12px;
    }

    @@media (max-width: 860px) {
        .cr-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="cr-container">

    <!-- BREADCRUMB -->
    <div class="cr-breadcrumb">
        <a asp-action="Index">Manage Cars</a>
        <span>/</span>
        <span style="color:var(--ink); font-weight:600;">@Model.CarName</span>
    </div>

    <div class="cr-grid">

        <!-- LEFT: DETAILS -->
        <div class="cr-card">
            <div class="cr-hero">
                <div>
                    <h1 class="cr-hero-name">@Model.CarName</h1>
                    <p class="cr-hero-sub">@Model.Brand · @Model.Model · <span class="cr-plate">@Model.LicensePlate</span></p>
                </div>
                <span class="status status-@statusClass">@Model.Status</span>
            </div>

            <div class="cr-card-pad">
                <div class="cr-info">
                    <div class="cr-info-item">
                        <div class="cr-info-label">Brand</div>
                        <div class="cr-info-value">@Model.Brand</div>
                    </div>
                    <div class="cr-info-item">
                        <div class="cr-info-label">Model</div>
                        <div class="cr-info-value">@Model.Model</div>
                    </div>
                    <div class="cr-info-item">
                        <div class="cr-info-label">Type</div>
                        <div class="cr-info-value">@(Model.Type?.TypeName ?? "—")</div>
                    </div>
                    <div class="cr-info-item">
                        <div class="cr-info-label">License Plate</div>
                        <div class="cr-info-value">@Model.LicensePlate</div>
                    </div>
                    <div class="cr-info-item">
                        <div class="cr-info-label">Owner</div>
                        <div class="cr-info-value">@(Model.Owner?.Profile?.FullName ?? Model.Owner?.Email ?? "—")</div>
                    </div>
                    <div class="cr-info-item">
                        <div class="cr-info-label">Price Per Day</div>
                        <div class="cr-info-value cr-price-value">@Model.PricePerDay.ToString("N0") ₫</div>
                    </div>
                </div>
            </div>

            <!-- IMAGES -->
            <div class="cr-card-pad" style="border-top:1px solid var(--line);">
                <h3 class="cr-section-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21" /></svg>
                    Hình ảnh xe
                </h3>
                @if (Model.CarImages != null && Model.CarImages.Any())
                {
                    <div class="cr-gallery">
                        @foreach (var img in Model.CarImages)
                        {
                            <img src="@img.ImageUrl" alt="@Model.CarName" loading="lazy" />
                        }
                    </div>
                }
                else
                {
                    <div class="cr-no-image">Chưa có hình ảnh cho xe này.</div>
                }
            </div>
        </div>

        <!-- RIGHT: STATUS UPDATE + ACTIONS -->
        <div class="cr-card cr-card-pad">
            <h3 class="cr-section-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.2-8.5" /><path d="M21 3v6h-6" /></svg>
                Cập nhật trạng thái
            </h3>

            <form asp-action="UpdateStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.CarId" />

                <label class="cr-label">Trạng thái mới</label>
                <select name="newStatus" class="cr-select">
                    <option value="Available">Available — Sẵn sàng</option>
                    <option value="Rented">Rented — Đang thuê</option>
                    <option value="Maintenance">Maintenance — Bảo trì</option>
                    <option value="Inactive">Inactive — Ngừng hoạt động</option>
                </select>

                <div class="cr-form-actions">
                    <button type="submit" class="cr-btn cr-btn-success">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5" /></svg>
                        Lưu thay đổi
                    </button>
                    <a asp-action="Index" class="cr-btn cr-btn-ghost">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 19-7-7 7-7M19 12H5" /></svg>
                        Quay lại
                    </a>
                </div>
            </form>

            <div style="margin-top:22px; padding-top:22px; border-top:1px solid var(--line);">
                <a href="@Url.Action("Index", "StaffBooking", new { search = Model.LicensePlate })" class="cr-btn cr-btn-primary w-100" style="justify-content:center;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                    Xem Booking của xe này
                </a>
            </div>
        </div>

    </div>
</div>