@model IEnumerable<CarRetalWebsite.Models.Booking>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Bookings";

    var all = Model?.ToList() ?? new List<CarRetalWebsite.Models.Booking>();
    var totalCount = all.Count;
    var pendingCount = all.Count(b => b.Status == "Pending");
    var activeCount = all.Count(b => b.Status == "Active");
    var completedCount = all.Count(b => b.Status == "Completed");
    var revenue = all.Where(b => b.Status == "Completed").Sum(b => b.SubtotalFee);
}

<style>
    :root {
        --brand: #0284c7;
        --brand-dark: #0369a1;
        --ink: #0f172a;
        --muted: #64748b;
        --line: #e6eaf1;
        --bg: #f4f6fb;
        --card: #ffffff;
    }

    .cr-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 32px 20px 56px;
    }

    /* HEADER */
    .cr-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .cr-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--brand);
        margin-bottom: 10px;
    }

    .cr-title {
        font-size: 1.9rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .cr-count-badge {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--brand);
        background: rgba(37, 99, 235, 0.1);
        padding: 4px 12px;
        border-radius: 999px;
    }

    .cr-subtitle {
        color: var(--muted);
        margin: 8px 0 0;
        font-size: 0.95rem;
    }

    .cr-nav {
        display: flex;
        gap: 10px;
    }

    .cr-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        border-radius: 12px;
        padding: 11px 18px;
        border: 1px solid transparent;
        text-decoration: none;
        transition: all 0.18s ease;
        cursor: pointer;
        font-size: 0.9rem;
        line-height: 1;
    }

    .cr-btn-ghost {
        background: var(--card);
        color: var(--ink);
        border-color: var(--line);
    }

        .cr-btn-ghost:hover { border-color: var(--brand); color: var(--brand); }

    .cr-btn-primary {
        background: var(--brand);
        color: #fff;
        box-shadow: 0 8px 18px rgba(37, 99, 235, 0.25);
    }

        .cr-btn-primary:hover { background: var(--brand-dark); color: #fff; transform: translateY(-1px); }

    /* STATS */
    .cr-stats {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .cr-stat {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 18px 20px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
    }

    .cr-stat-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--muted);
        margin-bottom: 10px;
    }

    .cr-stat-value {
        font-size: 1.7rem;
        font-weight: 800;
        line-height: 1;
    }

    .cr-stat-value.small { font-size: 1.15rem; }

    .cr-dot {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        display: inline-block;
        margin-right: 6px;
        vertical-align: middle;
    }

    /* FILTER */
    .cr-filter {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 16px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
        margin-bottom: 20px;
    }

    .cr-filter-form {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
    }

    .cr-search-wrap {
        position: relative;
        flex: 1 1 320px;
    }

        .cr-search-wrap svg {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
        }

    .cr-input {
        width: 100%;
        border-radius: 12px;
        padding: 11px 14px 11px 42px;
        border: 1px solid var(--line);
        background: #fbfcfe;
        font-size: 0.92rem;
        color: var(--ink);
        transition: 0.18s ease;
    }

    .cr-select {
        border-radius: 12px;
        padding: 11px 14px;
        border: 1px solid var(--line);
        background: #fbfcfe;
        font-size: 0.92rem;
        color: var(--ink);
        min-width: 170px;
        transition: 0.18s ease;
    }

    .cr-input:focus, .cr-select:focus {
        outline: none;
        border-color: var(--brand);
        background: #fff;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
    }

    /* TABLE */
    .cr-table-card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 18px;
        box-shadow: 0 12px 34px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }

    .cr-table {
        width: 100%;
        border-collapse: collapse;
    }

        .cr-table thead th {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--muted);
            text-align: left;
            padding: 14px 18px;
            background: #f8fafc;
            border-bottom: 1px solid var(--line);
        }

        .cr-table tbody td {
            padding: 15px 18px;
            border-bottom: 1px solid var(--line);
            font-size: 0.9rem;
            vertical-align: middle;
        }

        .cr-table tbody tr:last-child td { border-bottom: none; }

        .cr-table tbody tr { transition: background 0.14s ease; }

            .cr-table tbody tr:hover { background: #f8fbff; }

    .cr-id {
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
        font-weight: 700;
        color: var(--brand);
    }

    .cr-cust-name {
        font-weight: 700;
        color: var(--ink);
    }

    .cr-cust-sub {
        font-size: 0.8rem;
        color: var(--muted);
    }

    .cr-plate {
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
        font-size: 0.8rem;
        font-weight: 600;
        background: #f1f5f9;
        border: 1px solid var(--line);
        padding: 3px 9px;
        border-radius: 8px;
        white-space: nowrap;
    }

    .cr-total {
        font-weight: 700;
        color: var(--ink);
        white-space: nowrap;
    }

    .status {
        display: inline-flex;
        align-items: center;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

        .status::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 999px;
            margin-right: 7px;
            background: currentColor;
        }

    .status-Pending { background: #fef3c7; color: #d97706; }
    .status-Approved { background: #dbeafe; color: #2563eb; }
    .status-Active { background: #dcfce7; color: #16a34a; }
    .status-Completed { background: #ede9fe; color: #7c3aed; }
    .status-Cancelled { background: #fee2e2; color: #dc2626; }

    .cr-actions {
        display: flex;
        gap: 8px;
    }

    .cr-btn-sm {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 12px;
        border-radius: 10px;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid var(--line);
        transition: 0.16s ease;
        white-space: nowrap;
    }

    .cr-btn-sm.detail {
        background: var(--brand);
        color: #fff;
        border-color: var(--brand);
    }

        .cr-btn-sm.detail:hover { background: var(--brand-dark); }

    .cr-btn-sm.car {
        background: var(--card);
        color: var(--ink);
    }

        .cr-btn-sm.car:hover { border-color: var(--brand); color: var(--brand); }

    .cr-empty {
        text-align: center;
        padding: 56px 20px;
        color: var(--muted);
    }

    @@media (max-width: 1000px) {
        .cr-stats { grid-template-columns: repeat(2, 1fr); }
        .cr-table-card { overflow-x: auto; }
        .cr-table { min-width: 860px; }
    }
</style>

<div class="cr-container">

    <!-- HEADER -->
    <div class="cr-header">
        <div>
            <span class="cr-eyebrow">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                Bảng điều khiển nhân viên
            </span>
            <h1 class="cr-title">
                Quản lý Booking
                <span class="cr-count-badge">@totalCount đơn</span>
            </h1>
            <p class="cr-subtitle">Xem, tìm kiếm và cập nhật trạng thái các đơn đặt xe.</p>
        </div>
        <div class="cr-nav">
            <a href="@Url.Action("Index", "StaffCar")" class="cr-btn cr-btn-ghost">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 16H9m10 0a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2m14 0V9a2 2 0 0 0-2-2h-1.5l-1-2h-5l-1 2H7a2 2 0 0 0-2 2v7"/><circle cx="7.5" cy="16.5" r="1.5"/><circle cx="16.5" cy="16.5" r="1.5"/></svg>
                Quản lý Xe
            </a>
            <a href="@Url.Action("Index", "StaffBooking")" class="cr-btn cr-btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                Quản lý Booking
            </a>
        </div>
    </div>

    <!-- STATS -->
    <div class="cr-stats">
        <div class="cr-stat">
            <div class="cr-stat-label">Tổng đơn</div>
            <div class="cr-stat-value">@totalCount</div>
        </div>
        <div class="cr-stat">
            <div class="cr-stat-label"><span class="cr-dot" style="background:#d97706;"></span>Chờ duyệt</div>
            <div class="cr-stat-value">@pendingCount</div>
        </div>
        <div class="cr-stat">
            <div class="cr-stat-label"><span class="cr-dot" style="background:#16a34a;"></span>Đang thuê</div>
            <div class="cr-stat-value">@activeCount</div>
        </div>
        <div class="cr-stat">
            <div class="cr-stat-label"><span class="cr-dot" style="background:#7c3aed;"></span>Hoàn thành</div>
            <div class="cr-stat-value">@completedCount</div>
        </div>
        <div class="cr-stat">
            <div class="cr-stat-label">Doanh thu</div>
            <div class="cr-stat-value small">@revenue.ToString("N0") ₫</div>
        </div>
    </div>

    <!-- FILTER -->
    <div class="cr-filter">
        <form method="get" class="cr-filter-form">
            <div class="cr-search-wrap">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="text" name="search" value="@ViewBag.Search" class="cr-input" placeholder="Tìm theo mã đơn, tên xe, khách hàng, email..." />
            </div>
            <select name="newStatus" class="cr-select">
                <option value="Available">Available — Sẵn sàng</option>
                <option value="Rented">Rented — Đang thuê</option>
                <option value="Maintenance">Maintenance — Bảo trì</option>
                <option value="Inactive">Inactive — Ngừng hoạt động</option>
            </select>
            <button type="submit" class="cr-btn cr-btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                Tìm kiếm
            </button>
            <a href="@Url.Action("Index", "StaffBooking")" class="cr-btn cr-btn-ghost">Xóa lọc</a>
        </form>
    </div>

    <!-- TABLE -->
    <div class="cr-table-card">
        <table class="cr-table">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Xe</th>
                    <th>Biển số</th>
                    <th>Thời gian thuê</th>
                    <th>Trạng thái</th>
                    <th>Tổng tiền</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var statusClass = (item.Status ?? "").Replace(" ", "");
                        <tr>
                            <td><span class="cr-id">#@item.BookingId</span></td>
                            <td>
                                <div class="cr-cust-name">@(item.Customer?.Profile?.FullName ?? "Khách hàng")</div>
                                <div class="cr-cust-sub">@(item.Customer?.Email ?? "—")</div>
                            </td>
                            <td>@(item.Car?.CarName ?? "N/A")</td>
                            <td><span class="cr-plate">@(item.Car?.LicensePlate ?? "—")</span></td>
                            <td>
                                <div>@item.StartDate.ToString("dd/MM/yyyy")</div>
                                <div class="cr-cust-sub">→ @item.EndDate.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td><span class="status status-@statusClass">@item.Status</span></td>
                            <td><span class="cr-total">@item.SubtotalFee.ToString("N0") ₫</span></td>
                            <td>
                                <div class="cr-actions">
                                    <a asp-action="Details" asp-route-id="@item.BookingId" class="cr-btn-sm detail">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                        Chi tiết
                                    </a>
                                    <a asp-controller="StaffCar" asp-action="Details" asp-route-id="@item.CarId" class="cr-btn-sm car">Xem xe</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8">
                            <div class="cr-empty">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="opacity:.4; margin-bottom:12px;"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                                <div style="font-weight:600;">Không có đơn đặt xe nào</div>
                                <div style="font-size:0.85rem;">Thử thay đổi từ khóa tìm kiếm hoặc bộ lọc.</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
