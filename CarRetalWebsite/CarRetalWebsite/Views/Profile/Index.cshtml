@model CarRetalWebsite.Models.UserProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    var editModel = (CarRetalWebsite.Models.EditProfileViewModel)ViewBag.EditModel;
    var changePasswordModel = (CarRetalWebsite.Models.ChangePasswordViewModel)ViewBag.ChangePasswordModel;
    var avatarDisplay = !string.IsNullOrEmpty(Model.AvatarUrl) ? Model.AvatarUrl : "/images/default-avatar.svg";
}

<style>
    .profile-header-card {
        background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
        border-radius: 20px;
        color: #ffffff;
        padding: 35px 30px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.15);
    }

    .profile-header-card::after {
        content: '';
        position: absolute;
        top: -50px;
        right: -50px;
        width: 200px;
        height: 200px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, rgba(255, 255, 255, 0) 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .avatar-wrapper {
        position: relative;
        width: 110px;
        height: 110px;
        margin: 0 auto;
    }

    .avatar-large {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
        transition: transform 0.3s ease;
    }

    .avatar-large:hover {
        transform: scale(1.03);
    }

    .stat-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 22px 20px;
        border: 1px solid #E2E8F0;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.03);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        height: 100%;
    }

    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 25px rgba(15, 23, 42, 0.08);
        border-color: #CBD5E1;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        margin-bottom: 12px;
    }

    .stat-icon.primary { background-color: rgba(99, 102, 241, 0.1); color: #4F46E5; }
    .stat-icon.success { background-color: rgba(16, 185, 129, 0.1); color: #10B981; }
    .stat-icon.warning { background-color: rgba(245, 158, 11, 0.1); color: #F59E0B; }
    .stat-icon.info { background-color: rgba(6, 182, 212, 0.1); color: #06B6D4; }

    .nav-tabs-custom {
        border-bottom: 2px solid #E2E8F0;
        gap: 10px;
    }

    .nav-tabs-custom .nav-link {
        border: none;
        color: #64748B;
        font-weight: 600;
        padding: 12px 22px;
        border-radius: 12px 12px 0 0;
        transition: all 0.25s ease;
        position: relative;
    }

    .nav-tabs-custom .nav-link:hover {
        color: #4F46E5;
        background-color: rgba(241, 245, 249, 0.6);
    }

    .nav-tabs-custom .nav-link.active {
        color: #4F46E5;
        background-color: transparent;
        border-bottom: 3px solid #4F46E5;
    }

    .info-group-title {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #94A3B8;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .info-group-value {
        font-size: 1.05rem;
        color: #1E293B;
        font-weight: 600;
    }

    .form-control-custom {
        border-radius: 12px;
        padding: 12px 16px;
        border: 1px solid #CBD5E1;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .form-control-custom:focus {
        border-color: #6366F1;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
    }

    .btn-gradient-primary {
        background: linear-gradient(135deg, #4F46E5 0%, #3730A3 100%);
        color: #ffffff;
        border: none;
        border-radius: 12px;
        padding: 12px 28px;
        font-weight: 600;
        box-shadow: 0 4px 15px rgba(79, 70, 229, 0.3);
        transition: all 0.25s ease;
    }

    .btn-gradient-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(79, 70, 229, 0.4);
        color: #ffffff;
    }

    .badge-role {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    .badge-customer { background-color: rgba(59, 130, 246, 0.2); color: #60A5FA; }
    .badge-owner { background-color: rgba(245, 158, 11, 0.2); color: #FBBF24; }
    .badge-admin { background-color: rgba(239, 68, 68, 0.2); color: #F87171; }
</style>

<div class="container py-4 my-2">
    <!-- Profile Header Banner -->
    <div class="profile-header-card mb-4" data-aos="fade-down">
        <div class="row align-items-center g-4">
            <div class="col-md-auto text-center">
                <div class="avatar-wrapper">
                    <img src="@avatarDisplay" id="headerAvatarPreview" alt="Avatar" class="avatar-large" />
                </div>
            </div>
            <div class="col-md text-center text-md-start">
                <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-2 mb-2">
                    <h2 class="fw-bold mb-0 text-white">@Model.FullName</h2>
                    @if (Model.RoleName == "Owner")
                    {
                        <span class="badge badge-role badge-owner"><i class="fa-solid fa-key me-1"></i> Chủ xe (Owner)</span>
                    }
                    else if (Model.RoleName == "Admin")
                    {
                        <span class="badge badge-role badge-admin"><i class="fa-solid fa-shield-halved me-1"></i> Quản trị viên</span>
                    }
                    else
                    {
                        <span class="badge badge-role badge-customer"><i class="fa-solid fa-user me-1"></i> Khách hàng</span>
                    }

                    @if (Model.Status == "Active")
                    {
                        <span class="badge bg-success-subtle text-success border border-success border-opacity-25 rounded-pill px-3 py-1 fs-7 fw-semibold">
                            <i class="fa-solid fa-circle-check me-1"></i> Hoạt động
                        </span>
                    }
                </div>

                <p class="text-white-50 mb-2 fs-6">
                    <i class="fa-regular fa-envelope me-2"></i>@Model.Email
                    <span class="mx-2">•</span>
                    <i class="fa-solid fa-phone me-2"></i>@Model.PhoneNumber
                </p>

                <p class="text-white-50 mb-0 fs-7">
                    <i class="fa-regular fa-calendar-check me-1"></i> Thành viên từ: @Model.CreatedAt.ToString("dd/MM/yyyy")
                </p>
            </div>
        </div>
    </div>

    <!-- Quick Statistics Cards (Role Aware) -->
    <div class="row g-3 mb-4" data-aos="fade-up">
        @if (Model.RoleName == "Owner")
        {
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon primary">
                        <i class="fa-solid fa-car"></i>
                    </div>
                    <div class="info-group-title">Tổng xe ký gửi</div>
                    <div class="fs-3 fw-bold text-dark">@Model.TotalCars <span class="fs-6 fw-normal text-muted">chiếc</span></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon info">
                        <i class="fa-solid fa-clipboard-list"></i>
                    </div>
                    <div class="info-group-title">Lượt khách đặt xe</div>
                    <div class="fs-3 fw-bold text-dark">@Model.TotalOwnerBookings <span class="fs-6 fw-normal text-muted">đơn</span></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon success">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                    <div class="info-group-title">Doanh thu thực nhận</div>
                    <div class="fs-3 fw-bold text-success">@Model.TotalOwnerRevenue.ToString("N0") <span class="fs-6 fw-normal text-muted">VNĐ</span></div>
                </div>
            </div>
        }
        else
        {
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon primary">
                        <i class="fa-solid fa-route"></i>
                    </div>
                    <div class="info-group-title">Tổng chuyến đi đã đặt</div>
                    <div class="fs-3 fw-bold text-dark">@Model.TotalBookings <span class="fs-6 fw-normal text-muted">chuyến</span></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon warning">
                        <i class="fa-solid fa-clock"></i>
                    </div>
                    <div class="info-group-title">Chuyến sắp/đang diễn ra</div>
                    <div class="fs-3 fw-bold text-dark">@Model.ActiveBookings <span class="fs-6 fw-normal text-muted">chuyến</span></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon success">
                        <i class="fa-solid fa-coins"></i>
                    </div>
                    <div class="info-group-title">Tổng chi tiêu thuê xe</div>
                    <div class="fs-3 fw-bold text-primary">@Model.TotalSpent.ToString("N0") <span class="fs-6 fw-normal text-muted">VNĐ</span></div>
                </div>
            </div>
        }
    </div>

    <!-- Profile Navigation Tabs & Content -->
    <div class="card border-0 shadow-sm rounded-4" data-aos="fade-up" data-aos-delay="100">
        <div class="card-header bg-white border-0 pt-3 px-4 pb-0">
            <ul class="nav nav-tabs nav-tabs-custom" id="profileTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="view-tab" data-bs-toggle="tab" data-bs-target="#view-pane" type="button" role="tab">
                        <i class="fa-regular fa-address-card me-2"></i>Thông tin cá nhân
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="edit-tab" data-bs-toggle="tab" data-bs-target="#edit-pane" type="button" role="tab">
                        <i class="fa-solid fa-user-pen me-2"></i>Chỉnh sửa hồ sơ
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="password-tab" data-bs-toggle="tab" data-bs-target="#password-pane" type="button" role="tab">
                        <i class="fa-solid fa-lock me-2"></i>Đổi mật khẩu
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-4">
            <div class="tab-content" id="profileTabsContent">
                
                <!-- TAB 1: VIEW PROFILE (UC-12.1) -->
                <div class="tab-pane fade show active" id="view-pane" role="tabpanel">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="info-group-title"><i class="fa-solid fa-user me-2 text-primary"></i>Họ và tên</div>
                                <div class="info-group-value">@Model.FullName</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="info-group-title"><i class="fa-regular fa-envelope me-2 text-primary"></i>Email đăng ký</div>
                                <div class="info-group-value">@Model.Email <span class="badge bg-secondary ms-2 font-normal">Cố định</span></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="info-group-title"><i class="fa-solid fa-phone me-2 text-primary"></i>Số điện thoại liên hệ</div>
                                <div class="info-group-value">@Model.PhoneNumber</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="info-group-title"><i class="fa-solid fa-id-card me-2 text-primary"></i>Số Bằng lái xe (GPLX)</div>
                                <div class="info-group-value">
                                    @(string.IsNullOrWhiteSpace(Model.DriverLicenseNo) ? "Chưa cập nhật" : Model.DriverLicenseNo)
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="info-group-title"><i class="fa-solid fa-address-card me-2 text-primary"></i>Số CCCD / CMND</div>
                                <div class="info-group-value">
                                    @(string.IsNullOrWhiteSpace(Model.IdCardNo) ? "Chưa cập nhật" : Model.IdCardNo)
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="info-group-title"><i class="fa-solid fa-location-dot me-2 text-primary"></i>Địa chỉ thường trú</div>
                                <div class="info-group-value">
                                    @(string.IsNullOrWhiteSpace(Model.Address) ? "Chưa cập nhật" : Model.Address)
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 text-end">
                        <button class="btn btn-gradient-primary" onclick="switchToEditTab()">
                            <i class="fa-solid fa-pen-to-square me-2"></i>Chỉnh sửa hồ sơ
                        </button>
                    </div>
                </div>

                <!-- TAB 2: EDIT PROFILE (UC-12.2) -->
                <div class="tab-pane fade" id="edit-pane" role="tabpanel">
                    <form asp-controller="Profile" asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="row g-4">
                            <!-- Avatar Upload Section -->
                            <div class="col-12 text-center mb-2">
                                <div class="d-inline-block text-center">
                                    <img src="@avatarDisplay" id="formAvatarPreview" class="avatar-large mb-3" alt="Avatar Preview" />
                                    <div>
                                        <label for="AvatarFile" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                            <i class="fa-solid fa-camera me-1"></i> Chọn ảnh mới
                                        </label>
                                        <input type="file" id="AvatarFile" name="AvatarFile" class="d-none" accept="image/*" onchange="previewAvatarImage(this)" />
                                        <div class="form-text fs-7">Chấp nhận ảnh JPG, PNG, WEBP. Tối đa 5MB.</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                                <input type="text" name="FullName" class="form-control form-control-custom" value="@editModel.FullName" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                                <input type="text" name="PhoneNumber" class="form-control form-control-custom" value="@editModel.PhoneNumber" required pattern="^(03|05|07|08|09)\d{8}$" maxlength="10" title="Số điện thoại phải gồm 10 chữ số bắt đầu bằng 03, 05, 07, 08, 09" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Số Bằng lái xe (GPLX)</label>
                                <input type="text" name="DriverLicenseNo" class="form-control form-control-custom" value="@editModel.DriverLicenseNo" placeholder="Nhập 12 số GPLX..." pattern="^\d{12}$" maxlength="12" title="Số Giấy phép lái xe (GPLX) phải gồm đúng 12 chữ số" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Số CCCD / CMND</label>
                                <input type="text" name="IdCardNo" class="form-control form-control-custom" value="@editModel.IdCardNo" placeholder="Nhập 9 hoặc 12 số CCCD/CMND..." pattern="^(\d{9}|\d{12})$" maxlength="12" title="Số CCCD / CMND phải gồm đúng 9 hoặc 12 chữ số" />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Địa chỉ liên hệ</label>
                                <input type="text" name="Address" class="form-control form-control-custom" value="@editModel.Address" placeholder="Nhập địa chỉ nhà, tên đường, khu vực..." />
                            </div>
                        </div>

                        <div class="mt-4 text-end">
                            <button type="button" class="btn btn-light me-2 rounded-3 px-4" onclick="switchToViewTab()">Hủy</button>
                            <button type="submit" class="btn btn-gradient-primary">
                                <i class="fa-solid fa-floppy-disk me-2"></i>Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>

                <!-- TAB 3: CHANGE PASSWORD (UC-12.3) -->
                <div class="tab-pane fade" id="password-pane" role="tabpanel">
                    <form asp-controller="Profile" asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row justify-content-center">
                            <div class="col-md-8 col-lg-6">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <input type="password" id="CurrentPassword" name="CurrentPassword" class="form-control form-control-custom" required />
                                        <button class="btn btn-outline-secondary rounded-end-3" type="button" onclick="togglePasswordVisibility('CurrentPassword', this)">
                                            <i class="fa-regular fa-eye"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Mật khẩu mới <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <input type="password" id="NewPassword" name="NewPassword" class="form-control form-control-custom" minlength="6" required />
                                        <button class="btn btn-outline-secondary rounded-end-3" type="button" onclick="togglePasswordVisibility('NewPassword', this)">
                                            <i class="fa-regular fa-eye"></i>
                                        </button>
                                    </div>
                                    <div class="form-text fs-7">Tối thiểu 6 ký tự. Chiều dài hợp lệ giúp bảo vệ tài khoản tốt hơn.</div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-semibold">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <input type="password" id="ConfirmNewPassword" name="ConfirmNewPassword" class="form-control form-control-custom" minlength="6" required />
                                        <button class="btn btn-outline-secondary rounded-end-3" type="button" onclick="togglePasswordVisibility('ConfirmNewPassword', this)">
                                            <i class="fa-regular fa-eye"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="text-end">
                                    <button type="submit" class="btn btn-gradient-primary w-100">
                                        <i class="fa-solid fa-key me-2"></i>Cập nhật mật khẩu
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function switchToEditTab() {
            var editTab = new bootstrap.Tab(document.getElementById('edit-tab'));
            editTab.show();
        }

        function switchToViewTab() {
            var viewTab = new bootstrap.Tab(document.getElementById('view-tab'));
            viewTab.show();
        }

        function previewAvatarImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('formAvatarPreview').src = e.target.result;
                    document.getElementById('headerAvatarPreview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function togglePasswordVisibility(inputId, button) {
            var input = document.getElementById(inputId);
            var icon = button.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        @if (TempData["EditProfileSuccess"] != null)
        {
            <text>
            Toast.fire({
                icon: 'success',
                title: '@TempData["EditProfileSuccess"]'
            });
            </text>
        }

        @if (TempData["EditProfileError"] != null)
        {
            <text>
            Toast.fire({
                icon: 'error',
                title: '@TempData["EditProfileError"]'
            });
            switchToEditTab();
            </text>
        }

        @if (TempData["ChangePasswordSuccess"] != null)
        {
            <text>
            Toast.fire({
                icon: 'success',
                title: '@TempData["ChangePasswordSuccess"]'
            });
            </text>
        }

        @if (TempData["ChangePasswordError"] != null)
        {
            <text>
            Toast.fire({
                icon: 'error',
                title: '@TempData["ChangePasswordError"]'
            });
            var passTab = new bootstrap.Tab(document.getElementById('password-tab'));
            passTab.show();
            </text>
        }
    </script>
}
