@{
    Layout = null;
    var email = ViewBag.Email as string ?? "";
    var otpVerified = ViewBag.OtpVerified as bool? ?? false;
    var code = ViewBag.Code as string ?? "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đặt lại mật khẩu - CarRental</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- FontAwesome 6 CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet" />
    
    <!-- Common Shared CSS -->
    <link href="~/css/common.css" rel="stylesheet" />
    
    <style>
        body {
            background-color: #ffffff;
            height: 100vh;
            overflow: hidden;
            margin: 0;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .login-container {
            height: 100vh;
            display: flex;
        }

        @@keyframes slowZoom {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        /* Left Side: Coast Image */
        .login-sidebar {
            flex: 1.2;
            display: none;
            position: relative;
            overflow: hidden;
            animation: fadeIn 1s ease-out;
        }

        .login-sidebar::before {
            content: '';
            position: absolute;
            top: 0; right: 0; bottom: 0; left: 0;
            background: linear-gradient(rgba(2, 132, 199, 0.25), rgba(15, 23, 42, 0.65)), 
                        url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80') no-repeat center center;
            background-size: cover;
            animation: slowZoom 24s infinite ease-in-out;
            z-index: 1;
        }

        @@media (min-width: 992px) {
            .login-sidebar {
                display: flex;
                flex-direction: column;
                justify-content: flex-end;
                padding: 60px;
            }
        }

        .sidebar-content {
            color: #ffffff;
            z-index: 2;
            transform: translateY(0);
            animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
            opacity: 0;
        }

        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .sidebar-title {
            font-weight: 800;
            font-size: 2.75rem;
            margin-bottom: 18px;
            text-shadow: 0 4px 15px rgba(0,0,0,0.3);
            line-height: 1.2;
        }

        .sidebar-desc {
            font-size: 1.15rem;
            opacity: 0.95;
            text-shadow: 0 2px 8px rgba(0,0,0,0.25);
            font-weight: 350;
            max-width: 500px;
        }

        /* Right Side: Form */
        .login-form-area {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
            background-color: #f8fafc;
            overflow-y: auto;
        }

        .form-box {
            width: 100%;
            max-width: 440px;
            background: #ffffff;
            padding: 45px;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(15, 23, 42, 0.04);
            border: 1px solid rgba(226, 232, 240, 0.8);
            animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .brand-logo {
            color: var(--primary-color);
            font-size: 2.2rem;
            font-weight: 800;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 30px;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .brand-logo i {
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .brand-logo:hover {
            color: var(--primary-hover);
        }

        .brand-logo:hover i {
            transform: scale(1.15) rotate(-5deg);
        }

        .form-title {
            font-weight: 750;
            font-size: 1.8rem;
            color: var(--text-dark);
            margin-bottom: 8px;
        }

        .form-subtitle {
            color: var(--text-muted);
            margin-bottom: 35px;
            font-size: 0.95rem;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 20px;
        }

        .input-icon {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 1.15rem;
            z-index: 10;
            transition: color 0.3s ease;
        }

        .password-toggle {
            position: absolute;
            right: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            cursor: pointer;
            z-index: 10;
            transition: color 0.2s ease;
        }

        .password-toggle:hover {
            color: var(--primary-color);
        }

        .form-control-custom {
            width: 100%;
            padding: 14px 18px 14px 50px;
            border-radius: 12px;
            border: 1.5px solid #e2e8f0;
            font-weight: 500;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            background-color: #ffffff;
            font-size: 0.95rem;
            color: var(--text-dark);
        }

        .form-control-custom:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 4px var(--primary-light);
            outline: none;
        }

        .form-control-custom:focus + .input-icon {
            color: var(--primary-color);
        }

        .btn-login {
            background-color: var(--primary-color);
            color: #ffffff;
            border: none;
            font-weight: 600;
            padding: 14px;
            border-radius: 12px;
            width: 100%;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            font-size: 1rem;
            box-shadow: 0 4px 15px rgba(2, 132, 199, 0.2);
            cursor: pointer;
        }

        .btn-login:hover {
            background-color: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(2, 132, 199, 0.35);
        }

        .text-link {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .text-link:hover {
            color: var(--primary-hover);
            text-decoration: underline;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <!-- Left Side: Coast Image -->
        <div class="login-sidebar">
            <div class="sidebar-content">
                <h2 class="sidebar-title">Khám Phá Những Hành Trình Mới</h2>
                <p class="sidebar-desc">Hãy để CarRental đồng hành cùng bạn trên mọi nẻo đường Việt Nam. Thuận tiện, nhanh chóng và an toàn tuyệt đối.</p>
            </div>
        </div>

        <!-- Right Side: Form -->
        <div class="login-form-area">
            <div class="form-box">
                <!-- Brand logo -->
                <a href="/" class="brand-logo">
                    <i class="fa-solid fa-car-side"></i>
                    <span>CarRental</span>
                </a>

                <h1 class="form-title">Đặt lại mật khẩu</h1>
                <p class="form-subtitle">Điền mã xác thực OTP được gửi đến email và nhập mật khẩu mới của bạn.</p>

                <form asp-controller="Account" asp-action="ResetPassword" method="POST">
                    @Html.AntiForgeryToken()
                    
                    <!-- Email field (readonly) -->
                    <div class="input-group-custom">
                        <input type="email" name="email" class="form-control-custom bg-light" value="@email" readonly required />
                        <i class="fa-regular fa-envelope input-icon"></i>
                    </div>

                    <!-- OTP Section -->
                    <div id="otpSection" style="@(otpVerified ? "display: none;" : "")">
                        <!-- OTP Code input -->
                        <div class="input-group-custom">
                            <input type="text" id="code" name="code" class="form-control-custom" placeholder="Nhập mã OTP (6 chữ số)" required pattern="\d{6}" maxlength="6" autocomplete="off" value="@code" />
                            <i class="fa-solid fa-key input-icon"></i>
                        </div>

                        <!-- Verify OTP Button -->
                        <button type="button" id="verifyOtpBtn" class="btn-login mb-4">Xác minh mã OTP</button>
                    </div>

                    <!-- New Password container (hidden initially) -->
                    <div id="passwordSection" style="@(otpVerified ? "display: block;" : "display: none;")">
                        <!-- New Password input -->
                        <div class="input-group-custom">
                            <input type="password" id="password" name="password" class="form-control-custom" placeholder="Mật khẩu mới" required autocomplete="new-password" />
                            <i class="fa-solid fa-lock input-icon"></i>
                            <i class="fa-regular fa-eye password-toggle" id="togglePassword"></i>
                        </div>

                        <!-- Confirm Password input -->
                        <div class="input-group-custom">
                            <input type="password" id="confirmPassword" name="confirmPassword" class="form-control-custom" placeholder="Xác nhận mật khẩu mới" required autocomplete="new-password" />
                            <i class="fa-solid fa-lock input-icon"></i>
                            <i class="fa-regular fa-eye password-toggle" id="toggleConfirmPassword"></i>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" id="submitBtn" class="btn-login mb-4">Lưu mật khẩu mới</button>
                    </div>

                    <!-- Back to Login -->
                    <div class="text-center mt-3">
                        <a href="/Account/Login" class="text-link"><i class="fa-solid fa-arrow-left me-2"></i>Quay lại Đăng nhập</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Password visibility toggles
        const togglePassword = document.getElementById('togglePassword');
        const password = document.getElementById('password');
        togglePassword.addEventListener('click', function () {
            const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
            password.setAttribute('type', type);
            this.classList.toggle('fa-eye');
            this.classList.toggle('fa-eye-slash');
        });

        const toggleConfirmPassword = document.getElementById('toggleConfirmPassword');
        const confirmPassword = document.getElementById('confirmPassword');
        toggleConfirmPassword.addEventListener('click', function () {
            const type = confirmPassword.getAttribute('type') === 'password' ? 'text' : 'password';
            confirmPassword.setAttribute('type', type);
            this.classList.toggle('fa-eye');
            this.classList.toggle('fa-eye-slash');
        });

        // Toast configuration
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 4000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });

        // AJAX OTP verification flow
        const verifyOtpBtn = document.getElementById('verifyOtpBtn');
        const otpInput = document.getElementById('code');
        const emailInput = document.querySelector('input[name="email"]');
        const passwordSection = document.getElementById('passwordSection');

        verifyOtpBtn.addEventListener('click', async function() {
            const email = emailInput.value;
            const code = otpInput.value;

            if (!code || code.length !== 6 || !/^\d+$/.test(code)) {
                Toast.fire({
                    icon: 'error',
                    title: 'Vui lòng nhập mã OTP gồm 6 chữ số.'
                });
                return;
            }

            verifyOtpBtn.disabled = true;
            verifyOtpBtn.innerText = 'Đang xác minh...';

            try {
                const response = await fetch('/Account/VerifyOtp', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: new URLSearchParams({
                        email: email,
                        code: code,
                        __RequestVerificationToken: document.querySelector('input[name="__RequestVerificationToken"]').value
                    })
                });

                const result = await response.json();

                if (result.success) {
                    Toast.fire({
                        icon: 'success',
                        title: 'Xác thực OTP thành công!'
                    });

                    // Hide OTP section completely
                    document.getElementById('otpSection').style.display = 'none';

                    // Smooth reveal of password fields
                    passwordSection.style.display = 'block';
                    passwordSection.style.opacity = 0;
                    passwordSection.style.transform = 'translateY(10px)';
                    passwordSection.style.transition = 'all 0.5s ease';
                    
                    // Trigger reflow
                    passwordSection.offsetHeight; 
                    
                    passwordSection.style.opacity = 1;
                    passwordSection.style.transform = 'translateY(0)';
                } else {
                    Toast.fire({
                        icon: 'error',
                        title: result.message
                    });
                }
            } catch (error) {
                console.error('Error verifying OTP:', error);
                Toast.fire({
                    icon: 'error',
                    title: 'Đã xảy ra lỗi khi kết nối với máy chủ.'
                });
            } finally {
                verifyOtpBtn.disabled = false;
                verifyOtpBtn.innerText = 'Xác minh mã OTP';
            }
        });

        // Validate password form on submit
        const form = document.querySelector('form');
        form.addEventListener('submit', function(e) {
            if (passwordSection.style.display !== 'none') {
                const passVal = password.value;
                const confirmPassVal = confirmPassword.value;

                if (passVal.length < 6) {
                    e.preventDefault();
                    Toast.fire({
                        icon: 'error',
                        title: 'Mật khẩu mới phải chứa ít nhất 6 ký tự.'
                    });
                    return;
                }

                if (passVal !== confirmPassVal) {
                    e.preventDefault();
                    Toast.fire({
                        icon: 'error',
                        title: 'Mật khẩu xác nhận không trùng khớp.'
                    });
                    return;
                }
            }
        });

        @if (TempData["ResetPasswordError"] != null)
        {
            <text>
            Toast.fire({
                icon: 'error',
                title: '@Html.Raw(TempData["ResetPasswordError"])'
            });
            </text>
        }
    </script>
</body>
</html>
