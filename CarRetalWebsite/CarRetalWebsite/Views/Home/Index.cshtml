@model IEnumerable<CarRetalWebsite.Models.Car>
@{
    ViewData["Title"] = "Trang chủ";
}

<style>
    /* Slow breathing background animation for Hero */
    @@keyframes slowZoom {
        0% { transform: scale(1); }
        50% { transform: scale(1.04); }
        100% { transform: scale(1); }
    }

    /* Hero Section */
    .hero-section {
        position: relative;
        height: 560px;
        display: flex;
        align-items: center;
        color: #ffffff;
        overflow: hidden;
        background-color: #0f172a;
        border-radius: 0 0 40px 40px;
    }

    .hero-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.7) 0%, rgba(2, 132, 199, 0.4) 100%), 
                    url('https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1920&q=80') no-repeat center center;
        background-size: cover;
        z-index: 1;
        animation: slowZoom 24s infinite ease-in-out;
    }

    .hero-section .container {
        position: relative;
        z-index: 2;
    }

    .hero-title {
        font-weight: 800;
        font-size: 3.5rem;
        line-height: 1.25;
        text-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
    }

    .hero-subtitle {
        font-size: 1.25rem;
        font-weight: 300;
        margin-top: 18px;
        color: rgba(255, 255, 255, 0.95);
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        max-width: 650px;
        line-height: 1.6;
    }

    .hero-btn {
        transition: var(--transition-smooth);
        position: relative;
        overflow: hidden;
        z-index: 1;
        box-shadow: 0 6px 20px rgba(2, 132, 199, 0.35);
    }

    .hero-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 28px rgba(2, 132, 199, 0.5);
    }

    /* Filter Bar Container */
    .filter-wrapper {
        position: relative;
        margin-top: -65px;
        z-index: 10;
        padding-bottom: 60px;
    }

    .filter-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-radius: 24px;
        box-shadow: var(--shadow-lg);
        border: 1px solid rgba(226, 232, 240, 0.6);
        padding: 30px;
        transition: var(--transition-smooth);
    }

    .filter-card:hover {
        box-shadow: 0 30px 60px rgba(2, 132, 199, 0.12);
        transform: translateY(-2px);
    }

    .filter-label {
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
    }

    .filter-input {
        border-radius: 12px;
        border: 1.5px solid #e2e8f0;
        padding: 12px 16px;
        font-weight: 500;
        transition: var(--transition-smooth);
        background-color: #ffffff;
        font-size: 0.95rem;
    }

    .filter-input:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 4px var(--primary-light);
        outline: none;
    }

    /* Section Title */
    .section-title {
        font-weight: 800;
        font-size: 2.25rem;
        position: relative;
        padding-bottom: 16px;
        margin-bottom: 12px;
        display: inline-block;
        color: var(--text-dark);
    }

    .section-title::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 60px;
        height: 4px;
        background-color: var(--primary-color);
        border-radius: 4px;
    }

    .find-btn {
        transition: var(--transition-smooth);
    }

    .find-btn:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-primary);
    }
</style>

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <h1 class="hero-title" data-aos="fade-up">Thuê xe tự lái - Trải nghiệm hành trình tự do</h1>
                <p class="hero-subtitle" data-aos="fade-up" data-aos-delay="150">Đặt xe trực tuyến dễ dàng, nhanh chóng. Đa dạng mẫu xe từ bình dân đến cao cấp với chi phí tối ưu nhất.</p>
                <div class="mt-4" data-aos="fade-up" data-aos-delay="300">
                    <a href="/Car" class="btn-primary-custom py-3 px-4 fs-6 hero-btn">Khám Phá Ngay <i class="fa-solid fa-arrow-right ms-2"></i></a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Filter Section (UC-10) -->
<section class="container filter-wrapper" data-aos="fade-up" data-aos-delay="400">
    <div class="filter-card">
        <form action="/Car" method="GET">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="filter-label"><i class="fa-solid fa-magnifying-glass text-primary-custom"></i> Tên xe / Hãng xe</label>
                    <input type="text" class="form-control filter-input" name="keyword" placeholder="Nhập tên xe hoặc hãng xe..." />
                </div>
                <div class="col-md-3">
                    <label class="filter-label"><i class="fa-solid fa-car text-primary-custom"></i> Phân loại xe</label>
                    <select class="form-select filter-input" name="typeId">
                        <option value="">Tất cả phân loại</option>
                        <option value="1">Sedan</option>
                        <option value="2">SUV</option>
                        <option value="3">Crossover</option>
                        <option value="4">Bán tải</option>
                    </select>
                </div>
                <div class="col-md-2 col-sm-6">
                    <label class="filter-label"><i class="fa-regular fa-calendar-plus text-primary-custom"></i> Ngày nhận xe</label>
                    <input type="date" class="form-control filter-input" name="startDate" required value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2 col-sm-6">
                    <label class="filter-label"><i class="fa-regular fa-calendar-minus text-primary-custom"></i> Ngày trả xe</label>
                    <input type="date" class="form-control filter-input" name="endDate" required value="@DateTime.Now.AddDays(2).ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn-primary-custom w-100 py-3 text-center border-0 find-btn" style="margin-top: 0; line-height: 1.5; height: 50px;">
                        <i class="fa-solid fa-magnifying-glass me-2"></i> Tìm xe
                    </button>
                </div>
            </div>
        </form>
    </div>
</section>

<!-- Featured Cars Section (UC-08) -->
<section class="container mb-5 py-3">
    <div class="text-center mb-5" data-aos="fade-up">
        <h2 class="section-title">Danh Sách Xe Nổi Bật</h2>
        <p class="text-muted">Lựa chọn những dòng xe hàng đầu dành cho bạn với chất lượng tốt nhất và thủ tục nhanh gọn.</p>
    </div>

    <div class="row g-4 justify-content-center">
        @if (Model != null && Model.Any())
        {
            var index = 0;
            @foreach (var car in Model)
            {
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="@(index * 100)">
                    @await Html.PartialAsync("_CarCard", car)
                </div>
                index++;
            }
        }
        else
        {
            // Dự phòng nếu chưa có dữ liệu trong Database
            var demoCars = new List<Car>
            {
                new Car {
                    CarName = "Toyota Vios 2023",
                    Brand = "Toyota",
                    Type = new CarType { TypeName = "Sedan" },
                    PricePerDay = 800000,
                    SpecsJson = "{\"Transmission\":\"Số tự động\"}",
                    CarImages = new List<CarImage> { new CarImage { ImageUrl = "https://images.unsplash.com/photo-1605559424843-9e4c228bf1c2?auto=format&fit=crop&w=600&q=80", IsPrimary = true } }
                },
                new Car {
                    CarName = "Honda City 2022",
                    Brand = "Honda",
                    Type = new CarType { TypeName = "Sedan" },
                    PricePerDay = 850000,
                    SpecsJson = "{\"Transmission\":\"Số tự động\"}",
                    CarImages = new List<CarImage> { new CarImage { ImageUrl = "https://images.unsplash.com/photo-1619767886558-efdc259cde1a?auto=format&fit=crop&w=600&q=80", IsPrimary = true } }
                },
                new Car {
                    CarName = "Mazda CX-5 2023",
                    Brand = "Mazda",
                    Type = new CarType { TypeName = "SUV" },
                    PricePerDay = 1200000,
                    SpecsJson = "{\"Transmission\":\"Số tự động\"}",
                    CarImages = new List<CarImage> { new CarImage { ImageUrl = "https://images.unsplash.com/photo-1580273916550-e323be2ae537?auto=format&fit=crop&w=600&q=80", IsPrimary = true } }
                },
                new Car {
                    CarName = "Hyundai SantaFe 2022",
                    Brand = "Hyundai",
                    Type = new CarType { TypeName = "SUV" },
                    PricePerDay = 1500000,
                    SpecsJson = "{\"Transmission\":\"Số tự động\"}",
                    CarImages = new List<CarImage> { new CarImage { ImageUrl = "https://images.unsplash.com/photo-1549399542-7e3f8b79c341?auto=format&fit=crop&w=600&q=80", IsPrimary = true } }
                }
            };

            var index = 0;
            @foreach (var car in demoCars)
            {
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="@(index * 100)">
                    @await Html.PartialAsync("_CarCard", car)
                </div>
                index++;
            }
        }
    </div>
</section>
