@{
    ViewData["Title"] = ViewData["ErrorTitle"] ?? "Lỗi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var errorCode = ViewData["ErrorCode"] ?? 500;
    var errorTitle = ViewData["ErrorTitle"] ?? "Đã xảy ra lỗi hệ thống";
    var errorMessage = ViewData["ErrorMessage"] ?? "Chúng tôi xin lỗi vì sự bất tiện này. Vui lòng quay lại sau.";
}

<style>
    .error-section {
        min-height: calc(100vh - 200px);
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at 10% 20%, rgba(224, 242, 254, 0.3) 0%, rgba(248, 250, 252, 1) 90%);
        padding: 60px 20px;
    }

    .error-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 30px;
        padding: 50px 40px;
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.06);
        max-width: 620px;
        width: 100%;
        text-align: center;
        position: relative;
        overflow: hidden;
        transition: var(--transition-smooth);
    }

    .error-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 30px 70px rgba(15, 23, 42, 0.1);
        border-color: rgba(2, 132, 199, 0.2);
    }

    .error-badge {
        font-size: 8.5rem;
        font-weight: 850;
        line-height: 0.9;
        margin-bottom: 10px;
        letter-spacing: -2px;
        background: linear-gradient(135deg, var(--primary-color) 0%, #2563eb 50%, var(--accent-color) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: inline-block;
        position: relative;
        filter: drop-shadow(0 4px 10px rgba(2, 132, 199, 0.1));
    }

    .error-badge-overlay {
        position: absolute;
        top: 10px;
        right: -25px;
        font-size: 2.2rem;
        color: var(--accent-color);
        animation: floatOverlay 3s ease-in-out infinite;
    }

    @@keyframes floatOverlay {
        0%, 100% {
            transform: translateY(0) rotate(0deg);
        }
        50% {
            transform: translateY(-15px) rotate(20deg);
        }
    }

    .error-title {
        font-size: 1.8rem;
        font-weight: 750;
        color: var(--text-dark);
        margin-bottom: 15px;
    }

    .error-message {
        color: var(--text-muted);
        font-size: 1.05rem;
        font-weight: 500;
        line-height: 1.6;
        margin-bottom: 35px;
        max-width: 480px;
        margin-left: auto;
        margin-right: auto;
    }

    /* Animated Driving Scene */
    .animation-scene {
        position: relative;
        height: 70px;
        margin: 25px auto 35px auto;
        width: 80%;
        overflow: hidden;
    }

    .road-track {
        position: absolute;
        bottom: 8px;
        left: 0;
        width: 100%;
        height: 4px;
        background-color: #e2e8f0;
        border-radius: 2px;
    }

    .road-line-dashed {
        position: absolute;
        bottom: 9px;
        left: 0;
        width: 100%;
        height: 2px;
        border-top: 2px dashed #94a3b8;
    }

    .mini-car {
        position: absolute;
        bottom: 12px;
        font-size: 2.4rem;
        color: var(--primary-color);
        animation: driveAround 8s linear infinite;
        filter: drop-shadow(0 4px 6px rgba(2, 132, 199, 0.15));
    }

    @@keyframes driveAround {
        0% {
            left: -15%;
            transform: scaleX(1);
        }
        45% {
            left: 105%;
            transform: scaleX(1);
        }
        48% {
            left: 105%;
            transform: scaleX(-1);
        }
        93% {
            left: -15%;
            transform: scaleX(-1);
        }
        96% {
            left: -15%;
            transform: scaleX(1);
        }
        100% {
            left: -15%;
            transform: scaleX(1);
        }
    }

    /* Buttons */
    .button-group {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-back-prev {
        background-color: transparent;
        color: var(--text-dark);
        border: 2px solid #e2e8f0;
        font-weight: 600;
        padding: 10px 24px;
        border-radius: 12px;
        transition: var(--transition-smooth);
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
    }

    .btn-back-prev:hover {
        background-color: #f1f5f9;
        border-color: #cbd5e1;
        transform: translateY(-2px);
    }

    .btn-home {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 10px 28px;
    }
</style>

<div class="error-section">
    <div class="error-card" data-aos="zoom-in" data-aos-duration="600">
        <!-- Error Code -->
        <div class="error-badge">
            @errorCode
            <div class="error-badge-overlay">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
        </div>

        <!-- Title & Subtitle -->
        <h1 class="error-title">@errorTitle</h1>
        <p class="error-message">@errorMessage</p>

        <!-- Animation driving car -->
        <div class="animation-scene">
            <div class="road-track"></div>
            <div class="road-line-dashed"></div>
            <div class="mini-car">
                <i class="fa-solid fa-car-side"></i>
            </div>
        </div>

        <!-- Actions -->
        <div class="button-group">
            <a href="javascript:history.back()" class="btn-back-prev">
                <i class="fa-solid fa-arrow-left"></i> Quay lại trang trước
            </a>
            <a href="/" class="btn-primary-custom btn-home">
                <i class="fa-solid fa-house"></i> Về Trang chủ
            </a>
        </div>
    </div>
</div>
