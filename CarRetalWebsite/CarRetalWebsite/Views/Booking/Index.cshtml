@model IEnumerable<CarRetalWebsite.Models.Booking>
@{
    ViewData["Title"] = "Đơn đặt xe của tôi";
}

<style>
    .booking-card-item {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid rgba(226, 232, 240, 0.8);
        box-shadow: var(--shadow-sm);
        margin-bottom: 20px;
        padding: 25px;
        transition: var(--transition-smooth);
    }

    .booking-card-item:hover {
        box-shadow: var(--shadow-md);
        border-color: var(--primary-light);
    }

    .booking-car-thumb {
        width: 120px;
        height: 80px;
        object-fit: cover;
        border-radius: 10px;
        background-color: #f1f5f9;
    }

    .status-badge {
        font-weight: 700;
        font-size: 0.85rem;
        padding: 6px 16px;
        border-radius: 50px;
        display: inline-block;
    }

    .status-pending { background-color: #fef3c7; color: #d97706; }
    .status-approved { background-color: #e0f2fe; color: #0284c7; }
    .status-rejected { background-color: #fee2e2; color: #dc2626; }
    .status-active { background-color: #dcfce7; color: #15803d; }
    .status-completed { background-color: #ecfdf5; color: #059669; }
    .status-cancelled { background-color: #f1f5f9; color: #475569; }

    .fee-box {
        background-color: var(--bg-light);
        border-radius: 10px;
        padding: 10px 15px;
        font-size: 0.9rem;
    }

    .fee-label {
        color: var(--text-muted);
        font-weight: 550;
    }

    .fee-value {
        font-weight: 700;
        color: var(--text-dark);
        text-align: right;
    }
</style>

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h2 fw-bold text-dark"><i class="fa-solid fa-list-check me-2 text-primary"></i>Lịch sử đặt xe</h1>
            <p class="text-muted">Quản lý các chuyến đi và giao dịch của khách hàng <strong>Vũ Minh Khang</strong></p>
        </div>
        <div>
            <a href="/Car/Index" class="btn-primary-custom border-0 py-2.5 px-4">
                <i class="fa-solid fa-plus me-2"></i>Đặt xe mới
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filters -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background-color: #f8fafc;">
        <div class="card-body p-4">
            <form method="GET" action="/Booking/Index">
                <div class="row g-3 align-items-end">
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label fw-bold small text-muted text-uppercase">Tên xe / Hãng xe</label>
                        <input type="text" class="form-control" name="keyword" value="@ViewBag.Keyword" placeholder="Nhập tên xe..." />
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="form-label fw-bold small text-muted text-uppercase">Từ ngày</label>
                        <input type="date" class="form-control" name="startDate" value="@ViewBag.StartDate" />
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label class="form-label fw-bold small text-muted text-uppercase">Đến ngày</label>
                        <input type="date" class="form-control" name="endDate" value="@ViewBag.EndDate" />
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label fw-bold small text-muted text-uppercase">Trạng thái đơn</label>
                        <select class="form-select" name="status">
                            <option value="">Tất cả trạng thái</option>
                            <option value="Pending" selected="@(ViewBag.Status == "Pending")">Chờ duyệt (Pending)</option>
                            <option value="Approved" selected="@(ViewBag.Status == "Approved")">Đã duyệt (Approved)</option>
                            <option value="Rejected" selected="@(ViewBag.Status == "Rejected")">Từ chối (Rejected)</option>
                            <option value="Active" selected="@(ViewBag.Status == "Active")">Đang thuê (Active)</option>
                            <option value="Completed" selected="@(ViewBag.Status == "Completed")">Hoàn thành (Completed)</option>
                            <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Đã hủy (Cancelled)</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn-primary-custom w-100 border-0 py-2">Lọc</button>
                            <a href="/Booking/Index" class="btn btn-outline-secondary py-2" title="Xóa bộ lọc">
                                <i class="fa-solid fa-rotate-left"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Bookings List -->
    <div>
        @if (!Model.Any())
        {
            <div class="text-center py-5 bg-white rounded-4 border">
                <i class="fa-regular fa-folder-open display-2 text-muted mb-3"></i>
                <p class="lead text-muted">Bạn chưa có đơn đặt xe nào phù hợp với bộ lọc tìm kiếm.</p>
                <a href="/Car/Index" class="btn-outline-custom mt-2">Đặt xe ngay</a>
            </div>
        }
        else
        {
            foreach (var booking in Model)
            {
                var carImage = booking.Car.CarImages?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl 
                               ?? booking.Car.CarImages?.FirstOrDefault()?.ImageUrl 
                               ?? "https://images.unsplash.com/photo-1549399542-7e3f8b79c341?auto=format&fit=crop&w=600&q=80";

                var statusClass = "status-pending";
                var statusText = "Chờ duyệt";
                
                switch (booking.Status)
                {
                    case "Approved":
                        statusClass = "status-approved";
                        statusText = "Đã duyệt";
                        break;
                    case "Rejected":
                        statusClass = "status-rejected";
                        statusText = "Từ chối";
                        break;
                    case "Active":
                        statusClass = "status-active";
                        statusText = "Đang đi";
                        break;
                    case "Completed":
                        statusClass = "status-completed";
                        statusText = "Hoàn thành";
                        break;
                    case "Cancelled":
                        statusClass = "status-cancelled";
                        statusText = "Đã hủy";
                        break;
                }

                <div class="booking-card-item">
                    <div class="row align-items-center g-4">
                        <!-- Car Image and Name -->
                        <div class="col-lg-4 col-md-6 d-flex align-items-center gap-3">
                            <img src="@carImage" alt="@booking.Car.CarName" class="booking-car-thumb" />
                            <div>
                                <h3 class="h5 fw-bold text-dark mb-1">@booking.Car.CarName</h3>
                                <p class="small text-muted mb-1">Biển số: <strong>@booking.Car.LicensePlate</strong></p>
                                <span class="status-badge @statusClass">@statusText</span>
                            </div>
                        </div>

                        <!-- Date range -->
                        <div class="col-lg-3 col-md-6">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="fa-regular fa-calendar-check text-primary"></i>
                                <span class="fw-bold small">@booking.StartDate.ToString("dd/MM/yyyy")</span>
                                <span class="text-muted small">đến</span>
                                <span class="fw-bold small">@booking.EndDate.ToString("dd/MM/yyyy")</span>
                            </div>
                            <p class="small text-muted mb-0">Thời gian thuê: <strong>@booking.TotalDays ngày</strong></p>
                            <p class="small text-muted mb-0">Đặt lúc: @booking.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>

                        <!-- Fee Calculations -->
                        <div class="col-lg-3 col-md-6">
                            <div class="fee-box">
                                <div class="row g-1">
                                    <div class="col-7 fee-label">Tổng tiền (Subtotal):</div>
                                    <div class="col-5 fee-value">@booking.SubtotalFee.ToString("N0")đ</div>
                                    
                                    <div class="col-7 fee-label">Hoa hồng (10%):</div>
                                    <div class="col-5 fee-value text-muted" style="font-size: 0.85rem;">@booking.PlatformCommission.ToString("N0")đ</div>
                                    
                                    <div class="col-7 fee-label border-top pt-1 mt-1 fw-bold text-dark">Thanh toán chủ xe:</div>
                                    <div class="col-5 fee-value border-top pt-1 mt-1 text-primary fw-bold">@booking.OwnerPayout.ToString("N0")đ</div>
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="col-lg-2 col-md-6 text-lg-end">
                            @if (booking.Status == "Pending")
                            {
                                <form method="POST" action="/Booking/CancelBooking">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@booking.BookingId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm py-2 px-3 rounded-3 fw-bold w-100">
                                        <i class="fa-solid fa-ban me-1"></i>Hủy đặt xe
                                    </button>
                                </form>
                            }
                            else if (booking.Status == "Completed")
                            {
                                if (booking.Feedback == null)
                                {
                                    <a href="/Feedback/CreateFeedback?bookingId=@booking.BookingId" class="btn btn-primary btn-sm py-2 px-3 rounded-3 fw-bold w-100" style="background-color: var(--primary-color); border:none;">
                                        <i class="fa-solid fa-star me-1 text-warning"></i>Viết đánh giá
                                    </a>
                                }
                                else
                                {
                                    <div class="text-center">
                                        <span class="badge bg-success py-2 px-3 rounded-3 w-100 mb-2">Đã đánh giá</span>
                                        <a href="/Feedback/FeedbackDetails?id=@booking.Feedback.FeedbackId" class="small text-decoration-none">
                                            Xem đánh giá
                                        </a>
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">Không có thao tác</span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
