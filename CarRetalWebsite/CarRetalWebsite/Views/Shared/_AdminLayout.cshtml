<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Portal</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- FontAwesome 6 CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet" />
    
    <style>
        :root {
            --primary-blue: #0284c7;
            --primary-blue-hover: #0369a1;
            --bg-light: #f8fafc;
            --sidebar-bg: #ffffff;
            --text-gray: #64748b;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-light);
            min-height: 100vh;
            margin: 0;
            overflow-x: hidden;
        }

        /* Layout wrapper */
        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar Styling */
        .admin-sidebar {
            width: 260px;
            background-color: var(--sidebar-bg);
            color: #334155;
            border-right: 1px solid #e2e8f0;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 100;
        }

        .sidebar-brand {
            padding: 24px;
            font-size: 1.5rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid #e2e8f0;
            color: #0f172a;
            text-decoration: none;
        }

        .sidebar-brand i {
            color: var(--primary-blue);
        }

        .sidebar-menu {
            padding: 20px 12px;
            flex-grow: 1;
            list-style: none;
            margin: 0;
        }

        .menu-item {
            margin-bottom: 6px;
        }

        .menu-link {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 16px;
            color: #64748b;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            border-radius: 12px;
            transition: all 0.25s ease;
        }

        .menu-link:hover {
            background-color: #f1f5f9;
            color: #0f172a;
        }

        .menu-item.active .menu-link {
            background-color: var(--primary-blue);
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(2, 132, 199, 0.3);
        }

        .sidebar-footer {
            padding: 20px;
            border-top: 1px solid #e2e8f0;
        }

        /* Main Content Container */
        .admin-main {
            margin-left: 260px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            transition: all 0.3s ease;
        }

        /* Header Navbar */
        .admin-navbar {
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 16px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .navbar-title {
            font-weight: 750;
            font-size: 1.25rem;
            color: #0f172a;
            margin: 0;
        }

        .navbar-user {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .user-info {
            text-align: right;
        }

        .user-name {
            font-weight: 700;
            font-size: 0.9rem;
            color: #0f172a;
            display: block;
        }

        .user-role {
            font-size: 0.75rem;
            color: var(--text-gray);
            font-weight: 500;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #e2e8f0;
        }

        /* Content Wrapper */
        .admin-content {
            padding: 30px;
            flex-grow: 1;
        }

        /* Responsive */
        @@media (max-width: 991.98px) {
            .admin-sidebar {
                transform: translateX(-260px);
            }
            .admin-sidebar.show {
                transform: translateX(0);
            }
            .admin-main {
                margin-left: 0;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div class="admin-wrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar" id="adminSidebar">
            <a href="/Admin/Dashboard" class="sidebar-brand">
                <i class="fa-solid fa-car-side"></i>
                <span>CarRental</span>
            </a>
            
            <ul class="sidebar-menu">
                <li class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                    <a href="/Admin/Dashboard" class="menu-link">
                        <i class="fa-solid fa-chart-pie"></i>
                        <span>Tổng quan</span>
                    </a>
                </li>
                <li class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Staffs" ? "active" : "")">
                    <a href="/Admin/Staffs" class="menu-link">
                        <i class="fa-solid fa-user-shield"></i>
                        <span>Quản lý Nhân viên</span>
                    </a>
                </li>
                <li class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")">
                    <a href="/Admin/Users" class="menu-link">
                        <i class="fa-solid fa-users"></i>
                        <span>Quản lý Thành viên</span>
                    </a>
                </li>
                <li class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "RevenueReport" ? "active" : "")">
                    <a href="/Admin/RevenueReport" class="menu-link">
                        <i class="fa-solid fa-sack-dollar"></i>
                        <span>Báo cáo Doanh thu</span>
                    </a>
                </li>
                <li class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "OwnerRevenue" ? "active" : "")">
                    <a href="/Admin/OwnerRevenue" class="menu-link">
                        <i class="fa-solid fa-hand-holding-dollar"></i>
                        <span>Doanh thu Chủ xe</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <a href="/Account/Logout" class="menu-link text-danger w-100">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span>Đăng xuất</span>
                </a>
            </div>
        </aside>

        <!-- Main content area -->
        <div class="admin-main">
            <!-- Header navbar -->
            <header class="admin-navbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-light d-lg-none" onclick="toggleSidebar()">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <h2 class="navbar-title">Portal Quản Trị Viên</h2>
                </div>
                <div class="navbar-user">
                    <div class="user-info d-none d-sm-block">
                        <span class="user-name">@User.Identity?.Name</span>
                        <span class="user-role">Quản trị viên</span>
                    </div>
                    @{
                        var adminAvatar = User.FindFirst("AvatarUrl")?.Value;
                        if (string.IsNullOrWhiteSpace(adminAvatar))
                        {
                            adminAvatar = "/images/default-avatar.svg";
                        }
                    }
                    <img class="user-avatar" src="@adminAvatar" alt="Avatar" />
                </div>
            </header>

            <!-- Render page body -->
            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Bootstrap Bundle with Popper JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        function toggleSidebar() {
            document.getElementById('adminSidebar').classList.toggle('show');
        }

        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            showCloseButton: true,
            timer: 3000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });

        @if (TempData["LoginSuccess"] != null)
        {
            <text>
            Toast.fire({
                icon: 'success',
                title: 'Đăng nhập thành công!'
            });
            </text>
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
