@model List<CarRetalWebsite.Models.User>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý thành viên";
}

<!-- Custom Styles for User Management -->
<style>
    .grid-card {
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 10px 15px -3px rgba(15, 23, 42, 0.02);
        padding: 24px;
    }

    .table-custom th {
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        color: #475569;
        background-color: #f8fafc;
        border-bottom: 1.5px solid #cbd5e1;
        padding: 14px 16px;
    }

    .table-custom td {
        padding: 14px 16px;
        font-size: 0.92rem;
        color: #334155;
        vertical-align: middle;
    }

    .status-badge {
        padding: 5px 12px;
        font-weight: 600;
        font-size: 0.75rem;
        border-radius: 8px;
        display: inline-block;
    }

    .status-active { background-color: #dcfce7; color: #166534; }
    .status-inactive { background-color: #f1f5f9; color: #475569; }
    .status-banned { background-color: #fee2e2; color: #991b1b; }

    .role-badge {
        padding: 4px 10px;
        font-weight: 650;
        font-size: 0.75rem;
        border-radius: 8px;
        display: inline-block;
    }

    .role-customer { background-color: #e0f2fe; color: #0369a1; }
    .role-owner { background-color: #fef3c7; color: #d97706; }

    .action-btn {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        transition: all 0.2s ease;
        font-size: 0.88rem;
    }

    .btn-view-details { background-color: #e0f2fe; color: #0369a1; }
    .btn-view-details:hover { background-color: #bae6fd; transform: scale(1.05); }
    
    .btn-status-custom { background-color: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }
    .btn-status-custom:hover { background-color: #e2e8f0; transform: scale(1.05); }

    .btn-delete-custom { background-color: #fee2e2; color: #b91c1c; }
    .btn-delete-custom:hover { background-color: #fecaca; transform: scale(1.05); }

    .search-box-custom {
        border-radius: 12px;
        border: 1.5px solid #cbd5e1;
        padding: 10px 16px 10px 42px;
        font-size: 0.92rem;
        font-weight: 500;
        width: 100%;
        max-width: 320px;
        transition: all 0.3s ease;
    }

    .search-box-custom:focus {
        border-color: #0284c7;
        outline: none;
        box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.15);
    }

    .search-icon-wrapper {
        position: relative;
    }

    .search-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
    }

    .filter-select-custom {
        border-radius: 12px;
        border: 1.5px solid #cbd5e1;
        padding: 10px 16px;
        font-size: 0.92rem;
        font-weight: 550;
        color: #475569;
        transition: all 0.3s ease;
    }

    .filter-select-custom:focus {
        border-color: #0284c7;
        outline: none;
    }
</style>

<div class="mb-4">
    <h1 class="h3 fw-bold text-dark mb-1">Quản lý Thành viên (Khách hàng & Chủ xe)</h1>
    <p class="text-muted mb-0">Xem hồ sơ chi tiết bằng lái GPLX / CCCD, thay đổi trạng thái hoạt động hoặc xử lý vi phạm tài khoản.</p>
</div>

<div class="grid-card">
    <!-- Filters Header -->
    <form method="GET" action="/Admin/Users" class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3 flex-wrap w-100 w-md-auto">
            <div class="search-icon-wrapper">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input type="text" name="search" class="search-box-custom" placeholder="Tên, Email hoặc Số điện thoại..." value="@ViewBag.SearchTerm" />
            </div>
            
            <select name="role" class="form-select filter-select-custom w-auto" onchange="this.form.submit()">
                <option value="">Tất cả vai trò</option>
                <option value="Customer" selected="@(ViewBag.SelectedRole == "Customer")">Khách thuê xe</option>
                <option value="Owner" selected="@(ViewBag.SelectedRole == "Owner")">Chủ xe đối tác</option>
            </select>
        </div>
        
        @if (!string.IsNullOrWhiteSpace(ViewBag.SearchTerm) || !string.IsNullOrWhiteSpace(ViewBag.SelectedRole))
        {
            <a href="/Admin/Users" class="btn btn-link text-decoration-none text-secondary">
                <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
            </a>
        }
    </form>

    <!-- Table Grid -->
    <div class="table-responsive">
        <table class="table table-hover table-custom align-middle" id="userTable">
            <thead>
                <tr>
                    <th>Họ và tên</th>
                    <th>Email</th>
                    <th>Số điện thoại</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th>Ngày đăng ký</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var user in Model)
                    {
                        <tr id="row-@user.UserId">
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrWhiteSpace(user.Profile?.AvatarUrl) ? "/images/default-avatar.svg" : user.Profile.AvatarUrl)" width="38" height="38" class="rounded-circle border" style="width: 38px; height: 38px; object-fit: cover;" />
                                    <span class="fw-bold text-slate">@(user.Profile?.FullName ?? "N/A")</span>
                                </div>
                            </td>
                            <td>@user.Email</td>
                            <td>@user.PhoneNumber</td>
                            <td>
                                @if (user.Role?.RoleName == "Owner")
                                {
                                    <span class="role-badge role-owner">Chủ xe đối tác</span>
                                }
                                else
                                {
                                    <span class="role-badge role-customer">Khách thuê xe</span>
                                }
                            </td>
                            <td>
                                @if (user.Status == "Active")
                                {
                                    <span class="status-badge status-active">Đang hoạt động</span>
                                }
                                else if (user.Status == "Inactive")
                                {
                                    <span class="status-badge status-inactive">Ngừng hoạt động</span>
                                }
                                else
                                {
                                    <span class="status-badge status-banned">Bị khóa</span>
                                }
                            </td>
                            <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="action-btn btn-view-details" onclick="openDetails(@user.UserId)" title="Xem hồ sơ chi tiết">
                                        <i class="fa-solid fa-id-card"></i>
                                    </button>
                                    <button class="action-btn btn-status-custom" onclick="openStatusEdit(@user.UserId)" title="Cập nhật trạng thái">
                                        <i class="fa-solid fa-user-gear"></i>
                                    </button>
                                    <button class="action-btn btn-delete-custom" onclick="confirmDelete(@user.UserId)" title="Xóa tài khoản">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-users-slash fs-2 mb-3 d-block text-secondary"></i>
                            Không tìm thấy tài khoản người dùng nào khớp với bộ lọc.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination bar -->
    <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <label class="text-muted mb-0" style="font-size:0.88rem; white-space:nowrap;">Hiển thị</label>
            <select id="userPageSize" class="form-select form-select-sm" style="width:70px; border-radius:8px; font-weight:600;">
                <option value="5" selected>5</option>
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
            <span class="text-muted" id="userSummary" style="font-size:0.88rem;"></span>
        </div>
        <div class="d-flex gap-1 flex-wrap" id="userPagination"></div>
    </div>
</div>

<!-- ==========================================
     UC-21.3: MODAL - VIEW USER DETAILS
     ========================================== -->
<div class="modal fade" id="detailsUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="fw-bold text-dark"><i class="fa-solid fa-address-card text-primary me-2"></i>Hồ sơ thành viên chi tiết</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-4 text-center">
                <img id="detailAvatar" src="" class="rounded-circle border mb-3" width="90" height="90" style="object-fit: cover; aspect-ratio: 1/1;" />
                <h4 class="fw-bold text-dark mb-1" id="detailFullName"></h4>
                <div id="detailRoleBadge" class="mb-3"></div>
                
                <hr class="my-4 text-secondary opacity-25" />
                
                <div class="text-start">
                    <div class="row mb-2">
                        <div class="col-4 fw-semibold text-secondary">Email:</div>
                        <div class="col-8 text-dark fw-bold" id="detailEmail"></div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-4 fw-semibold text-secondary">Điện thoại:</div>
                        <div class="col-8 text-dark fw-bold" id="detailPhone"></div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-4 fw-semibold text-secondary">Trạng thái:</div>
                        <div class="col-8" id="detailStatus"></div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-4 fw-semibold text-secondary">Ngày tạo:</div>
                        <div class="col-8 text-dark fw-bold" id="detailCreatedAt"></div>
                    </div>
                    
                    <!-- Role-specific extra details -->
                    <div id="customerSection" style="display: none;">
                        <div class="row mb-2">
                            <div class="col-4 fw-semibold text-secondary">Số bằng lái (GPLX):</div>
                            <div class="col-8 text-success fw-bold" id="detailGPLX"></div>
                        </div>
                    </div>
                    
                    <div id="ownerSection" style="display: none;">
                        <div class="row mb-2">
                            <div class="col-4 fw-semibold text-secondary">Số CCCD / CMND:</div>
                            <div class="col-8 text-primary fw-bold" id="detailCCCD"></div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-4 fw-semibold text-secondary">Địa chỉ thường trú:</div>
                            <div class="col-8 text-dark fw-bold" id="detailAddress"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 pb-4 px-4 justify-content-end">
                <button type="button" class="btn btn-light rounded-3 px-4 fw-semibold" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================
     UC-21.4: MODAL - UPDATE USER STATUS
     ========================================== -->
<div class="modal fade" id="editUserStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <h5 class="fw-bold text-dark"><i class="fa-solid fa-user-gear text-warning me-2"></i>Thay đổi trạng thái</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editUserStatusForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" id="statusUserId" />
                
                <div class="modal-body px-4 py-3">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">Trạng thái tài khoản</label>
                        <select name="status" id="statusSelect" class="form-select rounded-3" required>
                            <option value="Active">Đang hoạt động</option>
                            <option value="Inactive">Ngừng hoạt động</option>
                            <option value="Banned">Bị khóa</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-4 px-4 justify-content-end">
                    <button type="button" class="btn btn-light rounded-3 px-3 fw-semibold" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-3 fw-semibold">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // SweetAlert2 Toast Helper
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true
        });

        // 1. Fetch User Details for View Modal
        function openDetails(id) {
            fetch(`/Admin/GetUserDetails?id=${id}`)
            .then(res => res.json())
            .then(data => {
                document.getElementById('detailAvatar').src = data.avatarUrl || '/images/default-avatar.svg';
                document.getElementById('detailFullName').textContent = data.fullName;
                document.getElementById('detailEmail').textContent = data.email;
                document.getElementById('detailPhone').textContent = data.phoneNumber;
                document.getElementById('detailCreatedAt').textContent = data.createdAt;
                
                // Role Badge
                const roleBadge = document.getElementById('detailRoleBadge');
                if (data.roleName === 'Owner') {
                    roleBadge.innerHTML = '<span class="role-badge role-owner">Chủ xe đối tác</span>';
                    document.getElementById('customerSection').style.display = 'none';
                    document.getElementById('ownerSection').style.display = 'block';
                    document.getElementById('detailCCCD').textContent = data.idCardNo;
                    document.getElementById('detailAddress').textContent = data.address;
                } else {
                    roleBadge.innerHTML = '<span class="role-badge role-customer">Khách thuê xe</span>';
                    document.getElementById('customerSection').style.display = 'block';
                    document.getElementById('ownerSection').style.display = 'none';
                    document.getElementById('detailGPLX').textContent = data.driverLicenseNo;
                }

                // Status Badge
                const statusDiv = document.getElementById('detailStatus');
                statusDiv.innerHTML = '';
                if (data.status === 'Active') {
                    statusDiv.innerHTML = '<span class="status-badge status-active">Đang hoạt động</span>';
                } else if (data.status === 'Inactive') {
                    statusDiv.innerHTML = '<span class="status-badge status-inactive">Ngừng hoạt động</span>';
                } else {
                    statusDiv.innerHTML = '<span class="status-badge status-banned">Bị khóa</span>';
                }
                
                new bootstrap.Modal(document.getElementById('detailsUserModal')).show();
            })
            .catch(() => {
                Toast.fire({
                    icon: 'error',
                    title: 'Không thể lấy thông tin chi tiết.'
                });
            });
        }

        // 2. Fetch User Status for Edit Modal
        function openStatusEdit(id) {
            fetch(`/Admin/GetUserDetails?id=${id}`)
            .then(res => res.json())
            .then(data => {
                document.getElementById('statusUserId').value = data.userId;
                document.getElementById('statusSelect').value = data.status;
                
                new bootstrap.Modal(document.getElementById('editUserStatusModal')).show();
            })
            .catch(() => {
                Toast.fire({
                    icon: 'error',
                    title: 'Không thể lấy thông tin trạng thái.'
                });
            });
        }

        // 3. AJAX Save User Status
        document.getElementById('editUserStatusForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const formData = new FormData(this);
            
            fetch('/Admin/UpdateUserStatus', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('editUserStatusModal')).hide();
                    Swal.fire({
                        icon: 'success',
                        title: 'Đã cập nhật!',
                        text: data.message,
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Toast.fire({
                        icon: 'error',
                        title: data.message
                    });
                }
            })
            .catch(() => {
                Toast.fire({
                    icon: 'error',
                    title: 'Lỗi xảy ra khi cập nhật trạng thái.'
                });
            });
        });

        // 4. AJAX Confirm and Delete User
        function confirmDelete(id) {
            Swal.fire({
                title: 'Bạn chắc chắn muốn xóa?',
                text: "Tài khoản thành viên và hồ sơ liên quan sẽ bị xóa vĩnh viễn khỏi hệ thống!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Có, xóa ngay!',
                cancelButtonText: 'Hủy bỏ',
                customClass: {
                    popup: 'rounded-4'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    const formData = new FormData();
                    formData.append('id', id);
                    formData.append('__RequestVerificationToken', token);
                    
                    fetch('/Admin/DeleteUser', {
                        method: 'POST',
                        body: formData
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            document.getElementById(`row-${id}`).fadeOutAndRemove();
                            Swal.fire({
                                icon: 'success',
                                title: 'Đã xóa!',
                                text: data.message,
                                timer: 2000,
                                showConfirmButton: false
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi xóa!',
                                text: data.message
                            });
                        }
                    })
                    .catch(() => {
                        Toast.fire({
                            icon: 'error',
                            title: 'Lỗi hệ thống khi xóa thành viên.'
                        });
                    });
                }
            });
        }

        // Row Fade Helper
        Element.prototype.fadeOutAndRemove = function () {
            this.style.transition = 'all 0.4s ease';
            this.style.opacity = 0;
            this.style.transform = 'translateY(10px)';
            setTimeout(() => {
                this.remove();
                // Check if table is empty
                const tableBody = document.querySelector('#userTable tbody');
                if (tableBody.querySelectorAll('tr').length === 0) {
                    tableBody.innerHTML = `
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-users-slash fs-2 mb-3 d-block text-secondary"></i>
                                Danh sách trống.
                            </td>
                        </tr>
                    `;
                }
            }, 400);
        };
        // Pagination
        const userPager = paginate(document.querySelector('#userTable tbody'), 'userSummary', 'userPagination', 5);
        document.getElementById('userPageSize').addEventListener('change', function() {
            userPager.setPageSize(parseInt(this.value));
        });

        function paginate(tbody, summaryId, pgId, initSize) {
            if (!tbody) return { setPageSize: () => {} };
            const rows = Array.from(tbody.querySelectorAll('tr'));
            let cur = 1;
            let pageSize = initSize;
            function render() {
                const total = rows.length;
                const pages = Math.ceil(total / pageSize) || 1;
                cur = Math.min(cur, pages);
                const s = (cur - 1) * pageSize;
                const e = Math.min(s + pageSize, total);
                rows.forEach((r, i) => r.style.display = (i >= s && i < e) ? '' : 'none');
                const sum = document.getElementById(summaryId);
                if (sum) sum.textContent = total ? `trên ${total} bản ghi` : '';
                const pg = document.getElementById(pgId);
                if (!pg) return;
                pg.innerHTML = '';
                const btn = (label, page, disabled, active) => {
                    const b = document.createElement('button');
                    b.innerHTML = label;
                    b.className = `btn btn-sm fw-semibold px-3 ${active ? 'btn-primary' : 'btn-light border'}`;
                    b.style.cssText = 'border-radius:8px; min-width:36px;';
                    b.disabled = disabled;
                    b.onclick = () => { cur = page; render(); };
                    pg.appendChild(b);
                };
                btn('‹', cur - 1, cur === 1, false);
                for (let i = 1; i <= pages; i++) btn(i, i, false, i === cur);
                btn('›', cur + 1, cur === pages, false);
            }
            render();
            return { setPageSize(size) { pageSize = size; cur = 1; render(); } };
        }
    </script>
}
