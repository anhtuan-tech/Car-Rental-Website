@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Doanh thu Chủ xe";
}

<style>
    .report-card {
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 10px 15px -3px rgba(15, 23, 42, 0.02);
        padding: 24px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .kpi-card { position: relative; overflow: hidden; border: none; color: #fff; }
    .kpi-card::before {
        content: ''; position: absolute;
        width: 150px; height: 150px;
        background: rgba(255,255,255,0.1); border-radius: 50%;
        top: -30px; right: -30px;
        transition: transform 0.5s ease;
    }
    .kpi-card:hover::before { transform: scale(1.2); }

    .kpi-blue   { background: linear-gradient(135deg, #0284c7 0%, #0ea5e9 100%); }
    .kpi-green  { background: linear-gradient(135deg, #10b981 0%, #34d399 100%); }
    .kpi-purple { background: linear-gradient(135deg, #8b5cf6 0%, #a78bfa 100%); }
    .kpi-teal   { background: linear-gradient(135deg, #0d9488 0%, #2dd4bf 100%); }

    .kpi-val { font-size: 1.8rem; font-weight: 800; margin: 0; letter-spacing: -0.5px; }
    .kpi-lbl { font-size: 0.85rem; font-weight: 600; opacity: 0.85; text-transform: uppercase; letter-spacing: 0.5px; margin: 0; }
    .kpi-icon { font-size: 1.5rem; opacity: 0.8; }

    .preset-btn {
        border-radius: 10px; padding: 6px 14px; font-size: 0.88rem;
        font-weight: 600; transition: all 0.2s ease;
        border: 1px solid #cbd5e1; background-color: #fff; color: #475569;
    }
    .preset-btn:hover, .preset-btn.active {
        background-color: #0284c7; color: #fff; border-color: #0284c7;
        transform: translateY(-1px); box-shadow: 0 4px 6px -1px rgba(2,132,199,0.2);
    }

    .table-owner th {
        font-weight: 700; font-size: 0.85rem; text-transform: uppercase;
        color: #475569; background-color: #f8fafc;
        border-bottom: 1.5px solid #cbd5e1; padding: 14px 16px;
    }
    .table-owner td { padding: 14px 16px; font-size: 0.92rem; color: #334155; vertical-align: middle; }

    .owner-avatar {
        width: 38px; height: 38px; border-radius: 50%;
        object-fit: cover; border: 2px solid #e2e8f0;
    }

    .search-box-custom {
        border-radius: 12px; border: 1.5px solid #cbd5e1;
        padding: 8px 16px 8px 38px; font-size: 0.9rem; font-weight: 500;
        width: 100%; max-width: 300px; transition: all 0.3s ease;
    }
    .search-box-custom:focus {
        border-color: #0284c7; outline: none;
        box-shadow: 0 0 0 4px rgba(2,132,199,0.15);
    }
    .search-icon-wrapper { position: relative; }
    .search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; }


    .progress-mini {
        height: 6px; border-radius: 10px; background: #f1f5f9; overflow: hidden;
    }
    .progress-mini-bar { height: 100%; border-radius: 10px; background: linear-gradient(90deg, #10b981, #34d399); }

    .chart-container-sm { position: relative; height: 300px; width: 100%; }
</style>

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Doanh thu Chủ xe đối tác</h1>
        <p class="text-muted mb-0">Thống kê chi tiết doanh thu, hoa hồng và khoản chi trả cho từng chủ xe đối tác.</p>
    </div>
    <a href="#" id="btnExportOwnerCsv" class="btn btn-success d-flex align-items-center gap-2 fw-semibold px-4 py-2" style="border-radius:12px;">
        <i class="fa-solid fa-file-excel"></i> Xuất CSV
    </a>
</div>

<!-- Filter Bar -->
<div class="report-card mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-lg-7 col-md-12">
            <label class="form-label fw-bold text-secondary mb-2">Khoảng thời gian nhanh</label>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="preset-btn" onclick="setPreset('today',    this)">Hôm nay</button>
                <button type="button" class="preset-btn" onclick="setPreset('last7',    this)">7 ngày qua</button>
                <button type="button" class="preset-btn active" onclick="setPreset('thismonth', this)">Tháng này</button>
                <button type="button" class="preset-btn" onclick="setPreset('lastmonth',this)">Tháng trước</button>
                <button type="button" class="preset-btn" onclick="setPreset('thisyear', this)">Năm nay</button>
            </div>
        </div>
        <div class="col-lg-5 col-md-12">
            <div class="row g-2">
                <div class="col-6">
                    <label class="form-label fw-bold text-secondary mb-1">Từ ngày</label>
                    <input type="date" id="startDate" class="form-control rounded-3" value="@ViewBag.StartDate" />
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold text-secondary mb-1">Đến ngày</label>
                    <input type="date" id="endDate"   class="form-control rounded-3" value="@ViewBag.EndDate" />
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="report-card kpi-card kpi-blue d-flex justify-content-between align-items-center">
            <div>
                <p class="kpi-lbl">Số chủ xe có đơn</p>
                <h3 class="kpi-val" id="valOwners">@ViewBag.TotalOwners</h3>
            </div>
            <div class="kpi-icon"><i class="fa-solid fa-users"></i></div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="report-card kpi-card kpi-green d-flex justify-content-between align-items-center">
            <div>
                <p class="kpi-lbl">Tổng doanh thu</p>
                <h3 class="kpi-val" id="valRevenue">@ViewBag.TotalRevenue.ToString("#,##0") đ</h3>
            </div>
            <div class="kpi-icon"><i class="fa-solid fa-sack-dollar"></i></div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="report-card kpi-card kpi-purple d-flex justify-content-between align-items-center">
            <div>
                <p class="kpi-lbl">Tổng chi trả chủ xe</p>
                <h3 class="kpi-val" id="valPayout">@ViewBag.TotalPayout.ToString("#,##0") đ</h3>
            </div>
            <div class="kpi-icon"><i class="fa-solid fa-hand-holding-dollar"></i></div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="report-card kpi-card kpi-teal d-flex justify-content-between align-items-center">
            <div>
                <p class="kpi-lbl">Tổng lượt đặt xe</p>
                <h3 class="kpi-val" id="valBookings">@ViewBag.TotalBookings</h3>
            </div>
            <div class="kpi-icon"><i class="fa-solid fa-receipt"></i></div>
        </div>
    </div>
</div>

<!-- Charts -->
<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="report-card h-100">
            <h4 class="fw-bold text-dark mb-4"><i class="fa-solid fa-chart-bar text-primary me-2"></i>Top chủ xe – Doanh thu so sánh</h4>
            <div class="chart-container-sm">
                <canvas id="ownerBarChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="report-card h-100">
            <h4 class="fw-bold text-dark mb-4"><i class="fa-solid fa-chart-pie text-warning me-2"></i>Tỷ trọng chi trả chủ xe</h4>
            <div class="chart-container-sm d-flex align-items-center justify-content-center">
                <canvas id="ownerPieChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Owner Detail Table -->
<div class="report-card">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <h4 class="fw-bold text-dark mb-0">
            <i class="fa-solid fa-table-list text-primary me-2"></i>Chi tiết từng Chủ xe
            <span class="badge bg-primary ms-2" id="ownerCountBadge" style="font-size:0.75rem;">0 chủ xe</span>
        </h4>
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <div class="search-icon-wrapper">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input type="text" id="ownerSearch" class="search-box-custom" placeholder="Tìm tên, email chủ xe..." />
            </div>
            <select id="sortBy" class="form-select rounded-3" style="width:auto; font-size:0.9rem; font-weight:600;">
                <option value="revenue">Sắp xếp: Doanh thu ↓</option>
                <option value="payout">Sắp xếp: Chi trả ↓</option>
                <option value="bookings">Sắp xếp: Số đơn ↓</option>
                <option value="name">Sắp xếp: Tên A-Z</option>
            </select>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-owner align-middle">
            <thead>
                <tr>
                    <th style="width:50px;">#</th>
                    <th>Chủ xe</th>
                    <th class="text-center">Số xe</th>
                    <th class="text-center">Tổng đơn</th>
                    <th class="text-center">Hoàn thành</th>
                    <th class="text-center">Đã hủy</th>
                    <th class="text-end">Tổng doanh thu</th>
                    <th class="text-end">Hoa hồng (10%)</th>
                    <th class="text-end">Nhận về</th>
                    <th class="text-end">TB / đơn</th>
                    <th>Tỷ trọng</th>
                </tr>
            </thead>
            <tbody id="ownerTableBody"></tbody>
            <tfoot id="ownerTableFoot"></tfoot>
        </table>
    </div>

    <!-- Pagination bar -->
    <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <label class="text-muted mb-0" style="font-size:0.88rem; white-space:nowrap;">Hiển thị</label>
            <select id="ownerPageSize" class="form-select form-select-sm" style="width:70px; border-radius:8px; font-weight:600;">
                <option value="5" selected>5</option>
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="30">30</option>
                <option value="50">50</option>
            </select>
            <span class="text-muted" id="ownerSummary" style="font-size:0.88rem;"></span>
        </div>
        <div class="d-flex gap-1 flex-wrap" id="ownerPagination"></div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    let allOwnerStats    = @Html.Raw(ViewBag.OwnerStatsJson);
    let filteredOwners   = [...allOwnerStats];
    let ownerBarChart    = null;
    let ownerPieChart    = null;
    let grandTotalRevenue = 0;
    let ownerCurPage  = 1;
    let ownerPageSize = 5;

    document.addEventListener('DOMContentLoaded', function () {
        grandTotalRevenue = allOwnerStats.reduce((s, o) => s + (o.TotalRevenue || o.totalRevenue || 0), 0);
        renderCharts(allOwnerStats);
        renderOwnerTable(allOwnerStats);

        document.getElementById('startDate').addEventListener('change', () => { submitFilter(); resetPresets(); });
        document.getElementById('endDate').addEventListener('change',   () => { submitFilter(); resetPresets(); });
        document.getElementById('ownerSearch').addEventListener('input', applyFilters);
        document.getElementById('sortBy').addEventListener('change', applyFilters);
        document.getElementById('ownerPageSize').addEventListener('change', function() {
            ownerPageSize = parseInt(this.value);
            ownerCurPage = 1;
            renderOwnerTable(filteredOwners);
        });
    });

    function submitFilter() {
        const start = document.getElementById('startDate').value;
        const end   = document.getElementById('endDate').value;
        document.getElementById('btnExportOwnerCsv').href = `/Admin/ExportRevenueCsv?startDate=${start}&endDate=${end}`;

        fetch(`/Admin/OwnerRevenue?startDate=${start}&endDate=${end}`, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.json())
        .then(data => {
            allOwnerStats = data.ownerStats;
            grandTotalRevenue = allOwnerStats.reduce((s, o) => s + (o.totalRevenue || 0), 0);

            animateCount('valOwners',   data.totalOwners,   false);
            animateCount('valRevenue',  data.totalRevenue,  true);
            animateCount('valPayout',   data.totalPayout,   true);
            animateCount('valBookings', data.totalBookings, false);

            renderCharts(allOwnerStats);
            applyFilters();
        })
        .catch(e => console.error(e));
    }

    function applyFilters() {
        const q    = document.getElementById('ownerSearch').value.toLowerCase().trim();
        const sort = document.getElementById('sortBy').value;

        filteredOwners = allOwnerStats.filter(o => {
            const name  = (o.OwnerName  || o.ownerName  || '').toLowerCase();
            const email = (o.OwnerEmail || o.ownerEmail || '').toLowerCase();
            return !q || name.includes(q) || email.includes(q);
        });

        filteredOwners.sort((a, b) => {
            const av = v => v.TotalRevenue  || v.totalRevenue  || 0;
            const ap = v => v.TotalPayout   || v.totalPayout   || 0;
            const ab = v => v.TotalBookings || v.totalBookings || 0;
            const an = v => (v.OwnerName    || v.ownerName     || '');
            if (sort === 'revenue')  return av(b) - av(a);
            if (sort === 'payout')   return ap(b) - ap(a);
            if (sort === 'bookings') return ab(b) - ab(a);
            if (sort === 'name')     return an(a).localeCompare(an(b));
            return 0;
        });

        renderOwnerTable(filteredOwners);
    }

    function renderCharts(stats) {
        const top5     = [...stats].sort((a, b) => (b.TotalRevenue || b.totalRevenue || 0) - (a.TotalRevenue || a.totalRevenue || 0)).slice(0, 5);
        const labels   = top5.map(o => o.OwnerName  || o.ownerName  || 'N/A');
        const revenues = top5.map(o => o.TotalRevenue || o.totalRevenue || 0);
        const payouts  = top5.map(o => o.TotalPayout  || o.totalPayout  || 0);

        // Bar Chart
        if (ownerBarChart) ownerBarChart.destroy();
        ownerBarChart = new Chart(document.getElementById('ownerBarChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels,
                datasets: [
                    { label: 'Doanh thu gộp', data: revenues, backgroundColor: 'rgba(16,185,129,0.85)', borderRadius: 6 },
                    { label: 'Nhận về',        data: payouts,  backgroundColor: 'rgba(139,92,246,0.85)', borderRadius: 6 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'top', labels: { font: { family: 'Plus Jakarta Sans', weight: 'bold' } } },
                    tooltip: { callbacks: { label: ctx => ctx.dataset.label + ': ' + ctx.parsed.y.toLocaleString('vi-VN') + ' đ' } }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: { beginAtZero: true, ticks: { callback: v => (v / 1000000).toFixed(1) + 'M' } }
                }
            }
        });

        // Pie Chart
        if (ownerPieChart) ownerPieChart.destroy();
        const pieColors = ['#0284c7','#10b981','#f59e0b','#8b5cf6','#e11d48','#0d9488','#64748b'];
        ownerPieChart = new Chart(document.getElementById('ownerPieChart').getContext('2d'), {
            type: 'doughnut',
            data: {
                labels,
                datasets: [{
                    data: payouts,
                    backgroundColor: pieColors.slice(0, top5.length),
                    borderWidth: 2, borderColor: '#fff'
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, cutout: '60%',
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 12, padding: 12, font: { family: 'Plus Jakarta Sans', weight: 'bold' } } },
                    tooltip: { callbacks: { label: ctx => ctx.label + ': ' + ctx.parsed.toLocaleString('vi-VN') + ' đ' } }
                }
            }
        });
    }

    function renderOwnerTable(stats) {
        const tbody = document.getElementById('ownerTableBody');
        const tfoot = document.getElementById('ownerTableFoot');
        tbody.innerHTML = '';
        tfoot.innerHTML = '';

        const total = stats ? stats.length : 0;
        document.getElementById('ownerCountBadge').textContent = total + ' chủ xe';

        if (!total) {
            tbody.innerHTML = `<tr><td colspan="11" class="text-center py-4 text-muted">
                Không có dữ liệu.</td></tr>`;
            renderOwnerPagination(0);
            return;
        }

        // Pagination slice
        const pages = Math.ceil(total / ownerPageSize) || 1;
        ownerCurPage = Math.min(ownerCurPage, pages);
        const s = (ownerCurPage - 1) * ownerPageSize;
        const e = Math.min(s + ownerPageSize, total);
        const pageStats = stats.slice(s, e);

        // Footer totals (all stats, not just page)
        let sumRev = 0, sumCom = 0, sumPay = 0, sumBk = 0;
        stats.forEach(o => {
            sumRev += o.TotalRevenue    || o.totalRevenue    || 0;
            sumCom += o.TotalCommission || o.totalCommission || 0;
            sumPay += o.TotalPayout     || o.totalPayout     || 0;
            sumBk  += o.TotalBookings   || o.totalBookings   || 0;
        });

        pageStats.forEach((o, i) => {
            const idx    = s + i; // global rank index
            const name   = o.OwnerName       || o.ownerName       || 'N/A';
            const email  = o.OwnerEmail      || o.ownerEmail      || '';
            const avatar = o.OwnerAvatar     || o.ownerAvatar     || '/images/default-avatar.svg';
            const cars   = o.TotalCars       || o.totalCars       || 0;
            const bks    = o.TotalBookings   || o.totalBookings   || 0;
            const comp   = o.CompletedCount  || o.completedCount  || 0;
            const canc   = o.CancelledCount  || o.cancelledCount  || 0;
            const rev    = o.TotalRevenue    || o.totalRevenue    || 0;
            const com    = o.TotalCommission || o.totalCommission || 0;
            const pay    = o.TotalPayout     || o.totalPayout     || 0;
            const avg    = o.AvgRevenue      || o.avgRevenue      || 0;
            const share  = grandTotalRevenue > 0 ? Math.round(rev / grandTotalRevenue * 100) : 0;

            tbody.innerHTML += `
                <tr>
                    <td class="fw-bold text-muted">${idx + 1}</td>
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            <img src="${avatar}" class="owner-avatar" onerror="this.src='/images/default-avatar.svg'">
                            <div>
                                <div class="fw-bold text-dark">${name}</div>
                                <div class="text-muted" style="font-size:0.8rem;">${email}</div>
                            </div>
                        </div>
                    </td>
                    <td class="text-center"><span class="badge bg-light text-dark border">${cars} xe</span></td>
                    <td class="text-center fw-semibold">${bks}</td>
                    <td class="text-center"><span class="badge" style="background:#dcfce7;color:#166534;">${comp}</span></td>
                    <td class="text-center"><span class="badge" style="background:#fee2e2;color:#991b1b;">${canc}</span></td>
                    <td class="text-end fw-bold" style="color:#0f172a;">${rev.toLocaleString('vi-VN')} đ</td>
                    <td class="text-end fw-bold" style="color:#ea580c;">${com.toLocaleString('vi-VN')} đ</td>
                    <td class="text-end fw-bold text-success">${pay.toLocaleString('vi-VN')} đ</td>
                    <td class="text-end text-muted" style="font-size:0.85rem;">${avg.toLocaleString('vi-VN')} đ</td>
                    <td style="min-width:90px;">
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress-mini flex-grow-1">
                                <div class="progress-mini-bar" style="width:${share}%"></div>
                            </div>
                            <small class="fw-bold text-muted">${share}%</small>
                        </div>
                    </td>
                </tr>`;
        });

        tfoot.innerHTML = `
            <tr style="border-top:2px solid #cbd5e1; background:#f8fafc;">
                <td colspan="3" class="fw-bold text-secondary" style="padding:12px 16px; font-size:0.85rem;">TỔNG CỘNG (${total} chủ xe)</td>
                <td class="text-center fw-bold">${sumBk}</td>
                <td></td><td></td>
                <td class="text-end fw-bold" style="color:#0f172a;">${sumRev.toLocaleString('vi-VN')} đ</td>
                <td class="text-end fw-bold" style="color:#ea580c;">${sumCom.toLocaleString('vi-VN')} đ</td>
                <td class="text-end fw-bold text-success">${sumPay.toLocaleString('vi-VN')} đ</td>
                <td></td><td></td>
            </tr>`;

        renderOwnerPagination(total);
    }

    function renderOwnerPagination(total) {
        const pages = Math.ceil(total / ownerPageSize) || 1;
        const sum = document.getElementById('ownerSummary');
        const pg  = document.getElementById('ownerPagination');
        if (!pg) return;

        if (sum) sum.textContent = total ? `trên ${total} bản ghi` : '';

        pg.innerHTML = '';
        if (total === 0) return;
        const btn = (label, page, disabled, active) => {
            const b = document.createElement('button');
            b.innerHTML = label;
            b.className = `btn btn-sm fw-semibold px-3 ${active ? 'btn-primary' : 'btn-light border'}`;
            b.style.cssText = 'border-radius:8px; min-width:36px;';
            b.disabled = disabled;
            b.onclick = () => { ownerCurPage = page; renderOwnerTable(filteredOwners); };
            pg.appendChild(b);
        };
        btn('‹', ownerCurPage - 1, ownerCurPage === 1, false);
        for (let i = 1; i <= pages; i++) btn(i, i, false, i === ownerCurPage);
        btn('›', ownerCurPage + 1, ownerCurPage === pages, false);
    }

    // ── Helpers ──────────────────────────────────────────────────────────────
    function animateCount(id, end, isCurrency) {
        const el = document.getElementById(id);
        if (!el) return;
        const start = parseInt(el.textContent.replace(/[^0-9]/g,'')) || 0;
        if (start === end) return;
        const dur = 700; let t0 = null;
        const step = ts => {
            if (!t0) t0 = ts;
            const p = Math.min((ts - t0) / dur, 1);
            const v = Math.floor(p * (end - start) + start);
            el.textContent = isCurrency ? v.toLocaleString('vi-VN') + ' đ' : v;
            if (p < 1) requestAnimationFrame(step);
            else el.textContent = isCurrency ? end.toLocaleString('vi-VN') + ' đ' : end;
        };
        requestAnimationFrame(step);
    }

    function setPreset(preset, btn) {
        document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const today = new Date();
        let start = new Date(), end = new Date();
        switch (preset) {
            case 'today':     start = today; end = today; break;
            case 'last7':     start.setDate(today.getDate() - 6); break;
            case 'thismonth': start = new Date(today.getFullYear(), today.getMonth(), 1); break;
            case 'lastmonth':
                start = new Date(today.getFullYear(), today.getMonth() - 1, 1);
                end   = new Date(today.getFullYear(), today.getMonth(), 0);
                break;
            case 'thisyear':  start = new Date(today.getFullYear(), 0, 1); break;
        }
        document.getElementById('startDate').value = fmt(start);
        document.getElementById('endDate').value   = fmt(end);
        submitFilter();
    }

    function resetPresets() { document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active')); }

    function fmt(d) {
        const dd = new Date(d);
        return [dd.getFullYear(), String(dd.getMonth()+1).padStart(2,'0'), String(dd.getDate()).padStart(2,'0')].join('-');
    }

    @if (TempData["RevenueError"] != null)
    {
        <text>
        Swal.fire({
            icon: 'error',
            title: 'Lỗi bộ lọc',
            text: '@Html.Raw(TempData["RevenueError"])'
        });
        </text>
    }
</script>
}
