@{
    ViewData["Title"] = "Owner Dashboard";
}

<div class="owner-dashboard">
    <h1>Owner Dashboard</h1>

    <!-- Search Bar Section -->
    <div class="search-section">
        <div class="search-bar">
            <input type="text" id="searchInput" placeholder="Search by name, brand, model, or car type..." />
            <button onclick="searchCars()">Search</button>
        </div>
    </div>

    <!-- Cars List Section -->
    <div class="cars-section">
        <div class="section-header">
            <h2>My Cars</h2>
            <button class="btn-add-car" onclick="openAddCarModal()">+ Add New Car</button>
        </div>
        <div id="carsList" class="cars-list">
            <!-- Cars will be populated here -->
        </div>
    </div>

    <!-- Earnings and Rental Orders Sections -->
    <div class="dashboard-sections">
        <div class="section-card">
            <h3>View Earnings</h3>
            <p>Check your earnings and revenue statistics</p>
            <a href="@Url.Action("ViewEarning", "Owner")" class="btn-primary">View Earnings</a>
        </div>
        <div class="section-card">
            <h3>View Rental Orders</h3>
            <p>Manage and track your rental orders</p>
            <a href="@Url.Action("ViewRentalOrder", "Owner")" class="btn-primary">View Orders</a>
        </div>
    </div>
</div>

<!-- Car Details Modal -->
<div id="carModal" class="modal" style="display:none;">
    <div class="modal-content">
        <span class="close" onclick="closeCarModal()">&times;</span>
        <div id="carDetails">
            <!-- Car details will be displayed here -->
        </div>
        <div class="modal-actions">
            <button class="btn-update" onclick="openUpdateCarModal()">Update</button>
            <button class="btn-remove" onclick="requestCarRemoval()">Remove</button>
            <button class="btn-cancel" onclick="closeCarModal()">Cancel</button>
        </div>
    </div>
</div>

<!-- Add/Update Car Modal -->
<div id="addUpdateCarModal" class="modal" style="display:none;">
    <div class="modal-content">
        <span class="close" onclick="closeAddUpdateCarModal()">&times;</span>
        <h2 id="modalTitle">Add New Car</h2>
        <form id="carForm">
            <div class="form-group">
                <label>Car Name:</label>
                <input type="text" id="carName" required />
            </div>
            <div class="form-group">
                <label>Brand:</label>
                <input type="text" id="carBrand" required />
            </div>
            <div class="form-group">
                <label>Model:</label>
                <input type="text" id="carModel" required />
            </div>
            <div class="form-group">
                <label>Car Type:</label>
                <input type="text" id="carType" required />
            </div>
            <div class="form-group">
                <label>Price per Day:</label>
                <input type="number" id="carPrice" step="0.01" required />
            </div>
            <div class="form-group">
                <label>Description:</label>
                <textarea id="carDescription"></textarea>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-save" onclick="saveCarData()">Save</button>
                <button type="button" class="btn-cancel" onclick="closeAddUpdateCarModal()">Cancel</button>
            </div>
        </form>
    </div>
</div>

<style>
    .owner-dashboard {
        padding: 20px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .owner-dashboard h1 {
        margin-bottom: 30px;
        font-size: 28px;
        font-weight: bold;
    }

    .search-section {
        margin-bottom: 30px;
    }

    .search-bar {
        display: flex;
        gap: 10px;
    }

    .search-bar input {
        flex: 1;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
    }

    .search-bar button {
        padding: 10px 20px;
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
    }

    .search-bar button:hover {
        background-color: #0056b3;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .btn-add-car {
        padding: 10px 20px;
        background-color: #28a745;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-add-car:hover {
        background-color: #218838;
    }

    .cars-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .car-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 15px;
        cursor: pointer;
        transition: box-shadow 0.3s;
    }

    .car-card:hover {
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .car-card h3 {
        margin: 0 0 10px 0;
        font-size: 18px;
    }

    .car-card p {
        margin: 5px 0;
        font-size: 14px;
        color: #666;
    }

    .dashboard-sections {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
    }

    .section-card {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 25px;
        text-align: center;
        background-color: #f9f9f9;
    }

    .section-card h3 {
        font-size: 20px;
        margin-bottom: 10px;
    }

    .section-card p {
        color: #666;
        margin-bottom: 20px;
    }

    .btn-primary {
        display: inline-block;
        padding: 10px 30px;
        background-color: #007bff;
        color: white;
        text-decoration: none;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.3s;
    }

    .btn-primary:hover {
        background-color: #0056b3;
    }

    .modal {
        position: fixed;
        z-index: 1;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.4);
    }

    .modal-content {
        background-color: #fefefe;
        margin: 10% auto;
        padding: 20px;
        border: 1px solid #888;
        border-radius: 8px;
        width: 90%;
        max-width: 500px;
        max-height: 80vh;
        overflow-y: auto;
    }

    .close {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
    }

    .close:hover {
        color: black;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
        justify-content: center;
        margin-top: 20px;
    }

    .btn-update, .btn-remove, .btn-cancel, .btn-save {
        padding: 10px 20px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-update {
        background-color: #007bff;
        color: white;
    }

    .btn-update:hover {
        background-color: #0056b3;
    }

    .btn-remove {
        background-color: #dc3545;
        color: white;
    }

    .btn-remove:hover {
        background-color: #c82333;
    }

    .btn-save {
        background-color: #28a745;
        color: white;
    }

    .btn-save:hover {
        background-color: #218838;
    }

    .btn-cancel {
        background-color: #6c757d;
        color: white;
    }

    .btn-cancel:hover {
        background-color: #5a6268;
    }

    .form-group {
        margin-bottom: 15px;
    }

    .form-group label {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
    }

    .form-group input,
    .form-group textarea {
        width: 100%;
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
        box-sizing: border-box;
    }

    .form-group textarea {
        resize: vertical;
        min-height: 100px;
    }

    #carDetails {
        margin-bottom: 20px;
    }

    #carDetails p {
        margin: 10px 0;
        font-size: 14px;
    }
</style>

<script>
    let currentCar = null;
    let isUpdating = false;

    function loadCars() {
        // Fetch cars from server
        fetch('/Owner/GetCars')
            .then(response => response.json())
            .then(cars => displayCars(cars))
            .catch(error => console.error('Error loading cars:', error));
    }

    function displayCars(cars) {
        const carsList = document.getElementById('carsList');
        carsList.innerHTML = '';
        
        cars.forEach(car => {
            const carCard = document.createElement('div');
            carCard.className = 'car-card';
            carCard.onclick = () => showCarDetails(car);
            carCard.innerHTML = `
                <h3>${car.name}</h3>
                <p><strong>Brand:</strong> ${car.brand}</p>
                <p><strong>Model:</strong> ${car.model}</p>
                <p><strong>Type:</strong> ${car.carType}</p>
                <p><strong>Price:</strong> $${car.pricePerDay}/day</p>
            `;
            carsList.appendChild(carCard);
        });
    }

    function searchCars() {
        const searchQuery = document.getElementById('searchInput').value;
        fetch(`/Owner/SearchCars?query=${encodeURIComponent(searchQuery)}`)
            .then(response => response.json())
            .then(cars => displayCars(cars))
            .catch(error => console.error('Error searching cars:', error));
    }

    function showCarDetails(car) {
        currentCar = car;
        const carDetails = document.getElementById('carDetails');
        carDetails.innerHTML = `
            <h2>${car.name}</h2>
            <p><strong>Brand:</strong> ${car.brand}</p>
            <p><strong>Model:</strong> ${car.model}</p>
            <p><strong>Type:</strong> ${car.carType}</p>
            <p><strong>Price per Day:</strong> $${car.pricePerDay}</p>
            <p><strong>Description:</strong> ${car.description || 'No description'}</p>
        `;
        document.getElementById('carModal').style.display = 'block';
    }

    function closeCarModal() {
        document.getElementById('carModal').style.display = 'none';
        currentCar = null;
    }

    function openAddCarModal() {
        isUpdating = false;
        document.getElementById('modalTitle').textContent = 'Add New Car';
        document.getElementById('carForm').reset();
        document.getElementById('addUpdateCarModal').style.display = 'block';
    }

    function openUpdateCarModal() {
        if (!currentCar) return;
        
        isUpdating = true;
        document.getElementById('modalTitle').textContent = 'Update Car';
        document.getElementById('carName').value = currentCar.name;
        document.getElementById('carBrand').value = currentCar.brand;
        document.getElementById('carModel').value = currentCar.model;
        document.getElementById('carType').value = currentCar.carType;
        document.getElementById('carPrice').value = currentCar.pricePerDay;
        document.getElementById('carDescription').value = currentCar.description || '';
        
        document.getElementById('carModal').style.display = 'none';
        document.getElementById('addUpdateCarModal').style.display = 'block';
    }

    function closeAddUpdateCarModal() {
        document.getElementById('addUpdateCarModal').style.display = 'none';
        isUpdating = false;
    }

    function saveCarData() {
        const formData = {
            id: isUpdating ? currentCar.id : null,
            name: document.getElementById('carName').value,
            brand: document.getElementById('carBrand').value,
            model: document.getElementById('carModel').value,
            carType: document.getElementById('carType').value,
            pricePerDay: parseFloat(document.getElementById('carPrice').value),
            description: document.getElementById('carDescription').value
        };

        const url = isUpdating ? '/Owner/UpdateCar' : '/Owner/AddCar';
        
        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(formData)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                closeAddUpdateCarModal();
                closeCarModal();
                loadCars();
            } else {
                alert('Error: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred while saving the car.');
        });
    }

    function requestCarRemoval() {
        if (!currentCar) return;
        
        if (!confirm('Are you sure you want to request removal of this car? This will be sent for staff approval.')) {
            return;
        }

        fetch(`/Owner/RequestCarRemoval/${currentCar.id}`, {
            method: 'POST'
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('Removal request submitted successfully. Awaiting staff approval.');
                closeCarModal();
                loadCars();
            } else {
                alert('Error: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred while requesting car removal.');
        });
    }

    // Load cars when page loads
    window.addEventListener('load', loadCars);

    // Close modals when clicking outside
    window.onclick = function(event) {
        const carModal = document.getElementById('carModal');
        const addUpdateModal = document.getElementById('addUpdateCarModal');
        
        if (event.target === carModal) {
            carModal.style.display = 'none';
        }
        if (event.target === addUpdateModal) {
            addUpdateModal.style.display = 'none';
        }
    };
</script>
