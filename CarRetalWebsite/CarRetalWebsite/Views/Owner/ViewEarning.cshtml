@model List<BookingHistory>

@{
    ViewData["Title"] = "View Earning";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>Rental Bookings Revenue</h2>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Booking ID</th>
                        <th>Car</th>
                        <th>Customer</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Total Price</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        @if (booking.NewStatus == "Completed")
                        {
                            var order = booking.Booking;
                            <tr>
                                <td>@order.BookingId</td>
                                <td>@order.Car.CarName</td>
                                <td>@order.Customer.Profile?.FullName</td>
                                <td>@order.StartDate.ToString("dd/MM/yyyy")</td>
                                <td>@order.EndDate.ToString("dd/MM/yyyy")</td>
                                <td>$@order.OwnerPayout.ToString("F2")</td>
                                <td>
                                    <span class="badge bg-success">@booking.NewStatus</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Total Revenue</h5>
                        <p class="card-text display-6">
                            $@Model.Sum(b => b.Booking.OwnerPayout).ToString("F2")
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Completed Bookings</h5>
                        <p class="card-text display-6">
                            @Model.Count(b => b.NewStatus == "Completed")
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <strong>No completed bookings found.</strong> Your rental revenue will appear here once you have completed
            bookings.
        </div>
    }
</div>
